OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-4.1-mini
PHIOS_BOOK_ONE_SALES_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_endpoint_secret
BOOK_ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_characters
BOOK_ONE_SOURCE_SHA256=replace_with_64_character_pdf_sha256
BOOK_WATERMARK_SERVICE_URL=https://replace-with-watermark-service.example
BOOK_WATERMARK_SERVICE_TOKEN=replace_with_watermark_service_secret
RESEND_API_KEY=re_replace_with_your_key
BOOK_RECEIPT_FROM_EMAIL=PHI OS <books@your-verified-domain.example>

# KIR-R2-W16R2 model-backed composer (disabled by default)
PHIOS_KIR_R2_MODEL_GATEWAY_ENABLED=false
PHIOS_KIR_R2_W16R2B_PRODUCTION_ADMITTED=false
PHIOS_KIR_R2_OPENAI_MODEL=gpt-5.6-luna
DEEPSEEK_API_KEY=replace_with_your_key
PHIOS_KIR_R2_DEEPSEEK_MODEL=deepseek-v4-flash
