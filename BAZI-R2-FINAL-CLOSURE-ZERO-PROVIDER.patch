+  "authority": {
+    "digest": "3d39eb86506e43e80c1df5333539504c154e1794d1a2f8af7f8c23c69c91b97c",
+    "timingDigest": "8a0fa647bd6a15f8e74f836f9730d84524dceddfe5f86471d83370875055f9dc",
+    "realityDigest": "74234e98afe7498fb5daf1f36ac2d78acc339464f950703b8c019892f982b90b"
