  "rules": [
    {
      "ruleId": "OWNER-R1",
      "name": "SEMANTIC_COMPOSITION_FIRST",
      "statement": {
        "zh-Hans": "Runtime Owner 只能读取已 admission 的组合语义结果。原始 Gate、Line、Driver、Layer、行星、Gene Keys 标签或关键词不能直接选择 owner。"
      },
      "requirements": [
        "ADMITTED_COMPOSITION_RESULT",
        "ACCEPTED_SEMANTIC_TAGS"
      ],
      "onFailure": "UNKNOWN",
      "forbidden": [
        "RAW_GATE_TO_OWNER",
        "LINE_TO_OWNER",
        "DRIVER_TO_OWNER",
        "LAYER_TO_OWNER",
        "PLANET_TO_OWNER",
        "GENE_KEYS_LABEL_TO_OWNER"
      ],
