{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PHI OS RRE Load Reading v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "loadReadingCode",
    "realityReference",
    "currentLoad",
    "sources",
    "concentration",
    "transfer",
    "accumulation",
    "metricCreated",
    "medicalStressDiagnosisCreated",
    "treatmentAdviceCreated",
    "validationOnly",
    "persistentStoreWriteAllowed",
    "loadReadingDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-RRE-LOAD-READING-v1.0.0"
    },
    "loadReadingCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "realityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "version",
        "digest"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "currentLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observableReferences",
        "patternReferences",
        "supportReferences"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observableReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "patternReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "supportReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceCode",
          "sourceReference",
          "observableReferences",
          "supportReferences"
        ],
        "properties": {
          "sourceCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sourceReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "observableReferences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "supportReferences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        }
      }
    },
    "concentration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observableReferences",
        "patternReferences",
        "supportReferences"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observableReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "patternReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "supportReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observableReferences",
        "patternReferences",
        "supportReferences"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observableReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "patternReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "supportReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "accumulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observableReferences",
        "patternReferences",
        "supportReferences"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observableReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "patternReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "supportReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "metricCreated": {
      "const": false
    },
    "medicalStressDiagnosisCreated": {
      "const": false
    },
    "treatmentAdviceCreated": {
      "const": false
    },
    "validationOnly": {
      "const": true
    },
    "persistentStoreWriteAllowed": {
      "const": false
    },
    "loadReadingDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
