{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/rmo/canonical-reality-signal-v1.schema.json",
  "title": "PHI OS Canonical Reality Signal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "signalCode", "signalVersion", "componentType", "signalType", "signalDirection",
    "realityReference", "entityReferences", "eventReferences", "sourceReferences", "evidenceReferences",
    "dataNature", "certainty", "recordStatus", "evidenceEligibility", "interpretationState", "inferenceState",
    "authorityReference", "operationalMode", "persistentStoreWriteAllowed", "createdAt", "signalDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "PHI-OS-CANONICAL-REALITY-SIGNAL-v1.0.0"},
    "signalCode": {"type": "string", "pattern": "^RMO-SIGNAL-[A-Z0-9-]{4,100}$"},
    "signalVersion": {"$ref": "#/$defs/semver"},
    "componentType": {"const": "REALITY_SIGNAL"},
    "signalType": {"type": "string", "minLength": 1},
    "signalDirection": {"enum": ["PRESENT", "ABSENT", "CHANGED", "INCREASE", "DECREASE", "STABLE", "UNKNOWN"]},
    "realityReference": {"$ref": "#/$defs/realityReference"},
    "entityReferences": {"$ref": "#/$defs/referenceArray"},
    "eventReferences": {"$ref": "#/$defs/referenceArray"},
    "sourceReferences": {"$ref": "#/$defs/referenceArray"},
    "evidenceReferences": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dataNature": {"type": "string", "minLength": 1},
    "certainty": {"type": "string", "minLength": 1},
    "recordStatus": {"const": "RECORDED"},
    "evidenceEligibility": {"const": "NOT_EVALUATED"},
    "interpretationState": {"const": "NOT_INTERPRETED"},
    "inferenceState": {"const": "NOT_INFERRED"},
    "authorityReference": {"const": "content/runtime/reality-model-runtime/contracts/signal-runtime-contract-v1.json"},
    "operationalMode": {"const": "VALIDATION_ONLY"},
    "persistentStoreWriteAllowed": {"const": false},
    "createdAt": {"type": "string", "format": "date-time"},
    "signalDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "referenceArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "realityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realityCode", "realityVersion", "realityDigest"],
      "properties": {
        "realityCode": {"type": "string", "pattern": "^RMO-REALITY-[A-Z0-9-]{4,100}$"},
        "realityVersion": {"$ref": "#/$defs/semver"},
        "realityDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
