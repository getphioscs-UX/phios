    "bfaFinalPublicationApprovalRemainsHuman": true
  },
  "book2CompositeAuthority": {
    "coverageRegistry": "content/knowledge/reconciliation/kau-r4/book-2-canonical-coverage-v1.json",
    "humanResolution": "content/knowledge/reconciliation/kau-r4/kau-r4-human-resolution-v1.json",
    "acceptedDecision": "ACCEPT_COMPOSITE_SOURCE_COVERAGE",
    "coveredNodes": [
      "KN-B2-P6-005",
      "KN-B2-P6-012"
    ]
  },
  "authorityBoundary": {
    "createsCanonicalMeaning": false,
    "createsNewKauMappingAuthority": false,
    "createsHumanC2Approval": false,
    "createsHumanC3Approval": false,
    "createsBfaFinalApproval": false,
    "createsPublication": false
  }
