  "purpose": "Make Automatic C2/C3 consume the Human-accepted manuscript/mapping authority actually owned by each publication book instead of hard-coding BOOK-1 KAU-R3 and BOOK-1 section inventory semantics.",
  "rules": {
    "bookScopedSectionInventoryRequired": true,
