    "versionedKauHumanAcceptedAuthorityAllowed": true,
    "acceptedKauAuthorityPattern": "^KAU-R\\d+_HUMAN_ACCEPTED_",
    "book2KauR4PrimaryAuthorityIsNormalPath": true,
    "humanAcceptedCompositeSourceCoverageMaySatisfySourceBinding": true,
    "compositeCoverageRequiresExplicitHumanResolution": true,
    "compositeCoverageDoesNotCreateNewHumanApproval": true,
    "missingBookInventoryFailsClosed": true,
    "missingOrUnacceptedCoverageFailsClosed": true,
    "routineC2HumanReviewRemainsDisabled": true,
