{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/multilingual-published-retrieval-index-v1.schema.json",
  "title": "PHI OS Multilingual Published Retrieval Index Manifest",
  "type": "object",
  "required": ["indexCode","indexVersion","authorityDigest","recordCounts","projectionDigests","indexDigest"],
  "properties": {
    "indexCode": {"const": "PHI-OS-MULTILINGUAL-PUBLISHED-RETRIEVAL-INDEX"},
    "indexVersion": {"const": "1.0.0"},
    "authorityDigest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "recordCounts": {"type":"object"},
    "projectionDigests": {"type":"object"},
    "indexDigest": {"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
