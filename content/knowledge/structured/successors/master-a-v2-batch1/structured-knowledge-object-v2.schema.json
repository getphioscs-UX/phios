    },
    "observationTimeClass": {
      "type": [
        "string",
        "null"
      ],
      "x-authorityRef": {
        "path": "content/knowledge/answer-projection/contracts/kap-book-vii-observation-time-contract-v1.json",
        "sha256": "ba1fca7eef66f1e89d13328e05b6d6000291f1040aa33091749e14987095bd64"
      },
      "description": "Value is resolved and checked against existing KAP owner; this schema grants no evaluation authority."
    },
    "knowledgeState": {
      "type": [
        "string",
        "null"
      ],
      "x-authorityRef": {
        "path": "content/knowledge/answer-projection/contracts/kap-book-vii-knowledge-state-contract-v1.json",
        "sha256": "75089062567041f2e2c637a2fb99a596fb60284c560ce6757f05cdd232d7d0b6"
      },
      "description": "Value is resolved and checked against existing KAP owner; this schema grants no evaluation authority."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "bookCode": {
            "const": "BOOK-5"
