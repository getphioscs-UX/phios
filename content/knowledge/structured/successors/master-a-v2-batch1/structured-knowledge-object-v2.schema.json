        "CANONICAL_PUBLICATION",
        "CANONICAL_HISTORY",
        "HISTORICAL_RECONSTRUCTION",
        "STRUCTURED_KNOWLEDGE",
        "CURRENT_DATA",
        "DERIVED_RUNTIME_READOUT",
        "CONDITIONAL_PROJECTION",
        "UNKNOWN"
      ]
    },
    "evidenceState": {
      "enum": [
        "OBSERVED",
        "REPORTED",
        "MEASURED",
        "DOCUMENTED",
        "DERIVED",
        "INTERPRETED",
        "RECONSTRUCTED",
        "CONCEPTUAL",
        "PARTIAL",
        "CONTESTED",
        "UNKNOWN",
        "INSUFFICIENT_EVIDENCE",
        "CONFLICTING_EVIDENCE",
        "OUTSIDE_AUTHORITY",
        "CURRENT_DATA_REQUIRED"
