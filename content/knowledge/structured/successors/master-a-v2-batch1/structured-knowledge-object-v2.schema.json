    "unknownState": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "asOfDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sourceFreshness": {
      "type": "object",
      "required": [
        "state",
        "asOfDate"
      ],
      "properties": {
        "state": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN",
            "NOT_APPLICABLE"
