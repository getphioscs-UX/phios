{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MASTER A batch 1 candidate envelope successor of existing Structured Knowledge owner",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objectId",
    "bookCode",
    "partCode",
    "nodeCode",
    "objectType",
    "title",
    "definition",
    "sourceRefs",
    "relationships",
    "dataClass",
    "evidenceState",
    "unknownState",
    "asOfDate",
    "sourceFreshness",
    "lastReviewedAt",
    "version",
    "supersedes",
    "supersededBy",
    "projectionState",
    "runtimeEligibility",
