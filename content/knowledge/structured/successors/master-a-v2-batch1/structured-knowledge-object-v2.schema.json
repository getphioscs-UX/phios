    {
      "if": {
        "properties": {
          "bookCode": {
            "const": "BOOK-6"
          }
        }
      },
      "then": {
        "properties": {
          "partCode": {
            "const": "PART-13"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "bookCode": {
            "const": "BOOK-7"
          }
        }
      },
      "then": {
        "properties": {
          "partCode": {
            "const": "PART-14"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "bookCode": {
            "const": "BOOK-8"
          }
        }
      },
      "then": {
        "properties": {
          "partCode": {
            "const": "PART-15"
          }
        }
      }
    }
  ]
}

