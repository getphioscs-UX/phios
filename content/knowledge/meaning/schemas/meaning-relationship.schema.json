{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/knowledge/meaning-relationship.schema.json",
  "title": "PHI OS Meaning Relationship",
  "type": "object",
  "additionalProperties": false,
  "required": ["relationshipId", "sourceMeaningId", "targetMeaningId", "relationshipType", "authorityStatus", "version"],
  "properties": {
    "relationshipId": { "type": "string", "pattern": "^KMR-[A-Z0-9-]+$" },
    "sourceMeaningId": { "type": "string", "pattern": "^KM-[A-Z0-9-]+$" },
    "targetMeaningId": { "type": "string", "pattern": "^KM-[A-Z0-9-]+$" },
    "relationshipType": { "enum": ["depends_on", "forms", "amplifies", "constrains", "transitions_to", "related_to"] },
    "direction": { "enum": ["directed", "bidirectional"] },
    "authorityStatus": { "enum": ["candidate", "human_frozen", "retired"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
