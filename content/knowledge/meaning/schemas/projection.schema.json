{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/knowledge/projection.schema.json",
  "title": "PHI OS Knowledge Projection Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectionId", "nodeCode", "meaningId", "projectionType", "language", "lifecycleState", "reviewState", "publicationState", "version"],
  "properties": {
    "projectionId": { "type": "string", "pattern": "^KP-[A-Z0-9-]+$" },
    "nodeCode": { "type": "string", "pattern": "^KN-[A-Z0-9-]+$" },
    "meaningId": { "type": "string", "pattern": "^KM-[A-Z0-9-]+$" },
    "projectionType": { "enum": ["book", "website_article", "atlas", "journey", "professional", "academy"] },
    "language": { "enum": ["zh-Hans", "en"] },
    "sourceMeaningVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "assetReference": { "type": "string", "minLength": 1 },
    "lifecycleState": { "enum": ["planned", "candidate", "draft", "frozen", "retired"] },
    "reviewState": { "enum": ["not_reviewed", "in_review", "changes_requested", "approved"] },
    "publicationState": { "enum": ["not_publication_ready", "publication_ready", "published", "withdrawn"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
