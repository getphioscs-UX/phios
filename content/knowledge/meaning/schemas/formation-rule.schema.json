{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/knowledge/formation-rule.schema.json",
  "title": "PHI OS Formation Rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleId", "meaningId", "ruleType", "conditions", "authorityStatus", "version"],
  "properties": {
    "ruleId": { "type": "string", "pattern": "^KFR-[A-Z0-9-]+$" },
    "meaningId": { "type": "string", "pattern": "^KM-[A-Z0-9-]+$" },
    "ruleType": { "enum": ["trigger", "formation", "stabilising", "amplifying", "weakening", "transition", "ending"] },
    "conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "outcome": { "type": "string", "minLength": 1 },
    "boundary": { "type": "string", "minLength": 1 },
    "authorityStatus": { "enum": ["candidate", "human_frozen", "retired"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
