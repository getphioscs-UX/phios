{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Civilization Atlas transition window registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "status",
    "transitionWindows",
    "scaleShifts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "PHI-OS-BOOK-V-CIV-ATLAS-TRANSITIONS-v1.0.0"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "FOUNDATION",
        "ACTIVE",
        "FROZEN"
      ]
    },
    "transitionWindows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/window"
      }
    },
    "scaleShifts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scaleShift"
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transitionWindowId",
        "title",
        "timeRange",
        "beforeState",
        "pressure",
        "threshold",
        "transition",
        "newCapacity",
        "newLoad",
        "irreversibility",
        "successorReality",
        "relatedCases",
        "relatedTrajectories",
        "evidenceRefs",
        "authorityClass",
        "unknown"
      ],
      "properties": {
        "transitionWindowId": {
          "type": "string",
          "pattern": "^TW-[0-9]{2}$"
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh-Hans",
            "en"
          ],
          "properties": {
            "zh-Hans": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "timeRange": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startYear",
            "endYear",
            "approximate"
          ],
          "properties": {
            "startYear": {
              "type": [
                "integer",
                "null"
              ]
            },
            "endYear": {
              "type": [
                "integer",
                "null"
              ]
            },
            "approximate": {
              "type": "boolean"
            }
          }
        },
        "beforeState": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zh-Hans",
                "en"
              ],
              "properties": {
                "zh-Hans": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "pressure": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zh-Hans",
                "en"
              ],
              "properties": {
                "zh-Hans": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "threshold": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zh-Hans",
                "en"
              ],
              "properties": {
                "zh-Hans": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "transition": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zh-Hans",
                "en"
              ],
              "properties": {
                "zh-Hans": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "newCapacity": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zh-Hans",
                "en"
              ],
              "properties": {
                "zh-Hans": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "newLoad": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zh-Hans",
                "en"
              ],
              "properties": {
                "zh-Hans": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "irreversibility": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zh-Hans",
                "en"
              ],
              "properties": {
                "zh-Hans": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "successorReality": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zh-Hans",
                "en"
              ],
              "properties": {
                "zh-Hans": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "relatedCases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^CA-T"
          },
          "uniqueItems": true
        },
        "relatedTrajectories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^EV-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "authorityClass": {
          "enum": [
            "EVIDENCE_SERIES",
            "HISTORICAL_RECONSTRUCTION",
            "CONCEPTUAL_TRAJECTORY"
          ]
        },
        "unknown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "UNKNOWN",
                "CONTESTED",
                "PARTIAL",
                "RECONSTRUCTED",
                "OBSERVED"
              ]
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "note": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "zh-Hans",
                    "en"
                  ],
                  "properties": {
                    "zh-Hans": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "scaleShift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scaleShiftId",
        "title",
        "status",
        "transitionWindowIds"
      ],
      "properties": {
        "scaleShiftId": {
          "type": "string",
          "pattern": "^SS-[0-9]{2}$"
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh-Hans",
            "en"
          ],
          "properties": {
            "zh-Hans": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "status": {
          "enum": [
            "HISTORICAL",
            "OPEN"
          ]
        },
        "transitionWindowIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^TW-"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
