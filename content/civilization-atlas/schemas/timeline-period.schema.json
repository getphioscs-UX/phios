{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Civilization Atlas timeline periods registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "status",
    "periods"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "PHI-OS-BOOK-V-CIV-ATLAS-TIMELINE-v1.0.0"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "FOUNDATION",
        "ACTIVE",
        "FROZEN"
      ]
    },
    "periods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/period"
      }
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periodId",
        "order",
        "title",
        "startYear",
        "endYear",
        "approximate",
        "summary",
        "regionIds",
        "caseIds",
        "transitionWindowIds",
        "snapshotIds",
        "relatedPart12Nodes",
        "evidenceRefs",
        "unknown"
      ],
      "properties": {
        "periodId": {
          "type": "string",
          "pattern": "^T(?:0[0-9]|1[0-9])$"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 19
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh-Hans",
            "en"
          ],
          "properties": {
            "zh-Hans": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "startYear": {
          "type": "integer"
        },
        "endYear": {
          "type": "integer"
        },
        "approximate": {
          "type": "boolean"
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh-Hans",
            "en"
          ],
          "properties": {
            "zh-Hans": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "regionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "caseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^CA-T(?:0[0-9]|1[0-9])-[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "transitionWindowIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^TW-[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "snapshotIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^WS-(?:M[0-9]{4}|[0-9]{4})$"
          },
          "uniqueItems": true
        },
        "relatedPart12Nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^KN-"
          },
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^EV-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "unknown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "UNKNOWN",
                "CONTESTED",
                "PARTIAL",
                "RECONSTRUCTED",
                "OBSERVED"
              ]
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "note": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "zh-Hans",
                    "en"
                  ],
                  "properties": {
                    "zh-Hans": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  }
}
