  "northNodeAlgorithm": [
    "GeoMoonState(time) returns geocentric Moon position+velocity in EQJ",
    "Rotation_EQJ_ECT(time) defines EQJ -> true ecliptic of date",
    "RotateState(rotation,state) rotates position and velocity to ECT",
    "h = r × v",
    "n = z_hat × h = (-h_y, h_x, 0)",
    "longitude = normalize360(atan2(n_y,n_x) in degrees)"
  ],
  "southNodeAlgorithm": "normalize360(northNodeLongitude + 180)",
