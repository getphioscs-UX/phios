{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/cx/smr/customer-theme-ir-v1.schema.json",
  "title": "PHI OS Customer Theme IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "themeId", "methodId", "semanticClusterId", "headline", "primaryClaimRef", "supportClaimRefs", "tensionClaimRefs", "conditionClaimRefs", "whatStandsOut", "whyItMatters", "howItMayShow", "whenItMayDiffer", "realityQuestionRefs", "lineageRefs"],
  "properties": {
    "schemaVersion": {"const": "PHI-OS-CUSTOMER-THEME-IR-v1.0.0"},
    "themeId": {"type": "string", "minLength": 8},
    "methodId": {"enum": ["AST", "BZR", "ZWR", "NUM", "ECR"]},
    "semanticClusterId": {"type": "string", "minLength": 8},
    "headline": {"type": "string", "minLength": 1},
    "primaryClaimRef": {"type": "string", "minLength": 8},
    "supportClaimRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tensionClaimRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "conditionClaimRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "whatStandsOut": {"type": "string", "minLength": 1},
    "whyItMatters": {"type": ["string", "null"]},
    "howItMayShow": {"type": ["string", "null"]},
    "whenItMayDiffer": {"type": ["string", "null"]},
    "realityQuestionRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "lineageRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
