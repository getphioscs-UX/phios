{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"PHI-OS-CANONICAL-METHOD-PROJECTION-AST-v2.schema.json",
  "title":"PHI OS AST CanonicalMethodProjection v2",
  "type":"object",
  "required":["schemaVersion","projectionId","method","calculation","projection","unknown","evidence","version","execution","interpretation"],
  "properties":{
    "schemaVersion":{"const":"PHI-OS-CANONICAL-METHOD-PROJECTION-v2.0.0"},
    "projectionId":{"type":"string","pattern":"^CMP2-"},
    "method":{"type":"object"},
    "calculation":{
      "type":"object",
      "required":["status","deterministic","values","structures","cycles","positions"],
      "properties":{
        "positions":{"type":"array","minItems":12},
        "structures":{"type":"array","minItems":1}
      }
    },
    "projection":{"type":"object"},
    "unknown":{"type":"array"},
    "evidence":{"type":"array"},
    "version":{"type":"object"},
    "execution":{"type":"object"},
    "interpretation":{"type":"object","properties":{"included":{"const":false},"meaningAuthorityCreated":{"const":false},"professionalJudgmentCreated":{"const":false}}}
  },
  "additionalProperties":false
}
