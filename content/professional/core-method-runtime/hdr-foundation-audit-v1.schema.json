{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/core-method-runtime/hdr-foundation-audit-v1.schema.json",
  "title": "PHI OS HDR-W0 Foundation Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stageCode",
    "stageTitle",
    "status",
    "baseline",
    "methodIdentity",
    "sourceAuthorities",
    "inputBoundary",
    "calculationScope",
    "projectionScope",
    "professionalScope",
    "dependencies",
    "blockingFindings",
    "stageRules"
  ],
  "properties": {
    "schemaVersion": { "const": "PHI-OS-HDR-FOUNDATION-AUDIT-v1.0.0" },
    "stageCode": { "const": "HDR-W0" },
    "stageTitle": { "const": "Human Design Runtime Foundation Audit" },
    "status": { "const": "foundation_audited_runtime_not_activated" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit"],
      "properties": {
        "repository": { "const": "getphioscs-UX/phios" },
        "branch": { "const": "main" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "methodIdentity": { "type": "object" },
    "sourceAuthorities": { "type": "object" },
    "inputBoundary": { "type": "object" },
    "calculationScope": { "type": "object" },
    "projectionScope": { "type": "object" },
    "professionalScope": { "type": "object" },
    "dependencies": { "type": "object" },
    "blockingFindings": { "type": "array", "minItems": 1, "uniqueItems": true },
    "stageRules": { "type": "object" }
  }
}
