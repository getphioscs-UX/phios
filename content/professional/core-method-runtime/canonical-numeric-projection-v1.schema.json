{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Numeric Projection",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectionType",
    "projectionCode",
    "projectionVersion",
    "projectionValue",
    "projectionSource",
    "projectionConfidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-CANONICAL-NUMERIC-PROJECTION-v1.0.0"
    },
    "projectionType": {
      "enum": [
        "NUMBER",
        "NUMBER_STRUCTURE",
        "NUMBER_CYCLE"
      ]
    }
  }
}
