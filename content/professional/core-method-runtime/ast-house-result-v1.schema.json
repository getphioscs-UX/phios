{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/ast/ast-house-result-v1.schema.json",
  "title": "PHI OS AST House Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeCode",
    "runtimeVersion",
    "methodCode",
    "pluginCode",
    "calculationType",
    "executionMode",
    "utcIso",
    "timeScale",
    "referenceFrame",
    "observerMode",
    "observer",
    "houseSystemCode",
    "zodiacPolicyCode",
    "anglePolicyCode",
    "precisionPolicyCode",
    "ascendantLongitude",
    "midheavenLongitude",
    "descendantLongitude",
    "imumCoeliLongitude",
    "cusps",
    "placements",
    "lineage",
    "deterministic",
    "providerUsed",
    "aiUsed",
    "houseRuntimeCreated",
    "aspectRuntimeCreated",
    "projectionCreated",
    "interpretationCreated",
    "professionalConclusionCreated",
    "productionEligible"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-AST-HOUSE-RESULT-v1.0.0"
    },
    "runtimeCode": {
      "const": "AST_HOUSE_RUNTIME"
    },
    "runtimeVersion": {
      "const": "1.0.0"
    },
    "methodCode": {
      "const": "ASTROLOGY"
    },
    "pluginCode": {
      "const": "AST"
    },
    "calculationType": {
      "const": "HOUSE_STRUCTURE"
    },
    "executionMode": {
      "const": "validation"
    },
    "utcIso": {
      "type": "string",
      "format": "date-time"
    },
    "timeScale": {
      "type": "string",
      "minLength": 1
    },
    "referenceFrame": {
      "type": "string",
      "minLength": 1
    },
    "observerMode": {
      "const": "TOPOCENTRIC"
    },
    "observer": {
      "type": "object"
    },
    "houseSystemCode": {
      "type": "string",
      "minLength": 3
    },
    "zodiacPolicyCode": {
      "type": "string",
      "minLength": 3
    },
    "anglePolicyCode": {
      "type": "string",
      "minLength": 3
    },
    "precisionPolicyCode": {
      "type": "string",
      "minLength": 3
    },
    "ascendantLongitude": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "midheavenLongitude": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "descendantLongitude": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "imumCoeliLongitude": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "cusps": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "houseNumber",
          "longitude"
        ],
        "properties": {
          "houseNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "longitude": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          }
        }
      }
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bodyCode",
          "houseNumber"
        ],
        "properties": {
          "bodyCode": {
            "type": "string",
            "minLength": 1
          },
          "houseNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        }
      }
    },
    "lineage": {
      "type": "object"
    },
    "deterministic": {
      "const": true
    },
    "providerUsed": {
      "const": false
    },
    "aiUsed": {
      "const": false
    },
    "houseRuntimeCreated": {
      "const": true
    },
    "aspectRuntimeCreated": {
      "const": false
    },
    "projectionCreated": {
      "const": false
    },
    "interpretationCreated": {
      "const": false
    },
    "professionalConclusionCreated": {
      "const": false
    },
    "productionEligible": {
      "const": false
    }
  }
}
