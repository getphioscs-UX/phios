{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/ast/ast-aspect-result-v1.schema.json",
  "title": "PHI OS AST Aspect Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeCode",
    "runtimeVersion",
    "methodCode",
    "pluginCode",
    "calculationType",
    "executionMode",
    "utcIso",
    "timeScale",
    "referenceFrame",
    "observerMode",
    "aspectSetCode",
    "orbPolicyCode",
    "applyingPolicyCode",
    "priorityPolicyCode",
    "normalizationPolicyCode",
    "evaluatedBodyCount",
    "evaluatedPairCount",
    "aspects",
    "lineage",
    "deterministic",
    "providerUsed",
    "aiUsed",
    "aspectRuntimeCreated",
    "projectionCreated",
    "interpretationCreated",
    "knowledgeCreated",
    "realityConclusionCreated",
    "professionalConclusionCreated",
    "productionEligible"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-AST-ASPECT-RESULT-v1.0.0"
    },
    "runtimeCode": {
      "const": "AST_ASPECT_RUNTIME"
    },
    "runtimeVersion": {
      "const": "1.0.0"
    },
    "methodCode": {
      "const": "ASTROLOGY"
    },
    "pluginCode": {
      "const": "AST"
    },
    "calculationType": {
      "const": "GOVERNED_ASPECT_DETECTION"
    },
    "executionMode": {
      "const": "validation"
    },
    "utcIso": {
      "type": "string",
      "format": "date-time"
    },
    "timeScale": {
      "type": "string",
      "minLength": 1
    },
    "referenceFrame": {
      "type": "string",
      "minLength": 1
    },
    "observerMode": {
      "type": "string",
      "minLength": 1
    },
    "aspectSetCode": {
      "const": "MAJOR_ASPECTS_V1"
    },
    "orbPolicyCode": {
      "const": "EXACT_ONLY_VALIDATION_V1"
    },
    "applyingPolicyCode": {
      "const": "LONGITUDE_SPEED_DIRECTION_V1"
    },
    "priorityPolicyCode": {
      "const": "MAJOR_ASPECT_PRIORITY_V1"
    },
    "normalizationPolicyCode": {
      "const": "SHORTEST_ANGULAR_SEPARATION_V1"
    },
    "evaluatedBodyCount": {
      "type": "integer",
      "minimum": 2
    },
    "evaluatedPairCount": {
      "type": "integer",
      "minimum": 1
    },
    "aspects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pairCode",
          "bodyA",
          "bodyB",
          "longitudeA",
          "longitudeB",
          "separationDegrees",
          "aspectCode",
          "exactAngleDegrees",
          "orbDegrees",
          "authorizedOrbDegrees",
          "motionClassification",
          "priorityRank"
        ],
        "properties": {
          "pairCode": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+__[A-Z0-9_]+$"
          },
          "bodyA": {
            "type": "string",
            "minLength": 1
          },
          "bodyB": {
            "type": "string",
            "minLength": 1
          },
          "longitudeA": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "longitudeB": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "separationDegrees": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "aspectCode": {
            "enum": [
              "CONJUNCTION",
              "SEXTILE",
              "SQUARE",
              "TRINE",
              "OPPOSITION"
            ]
          },
          "exactAngleDegrees": {
            "enum": [
              0,
              60,
              90,
              120,
              180
            ]
          },
          "orbDegrees": {
            "const": 0
          },
          "authorizedOrbDegrees": {
            "const": 0
          },
          "motionClassification": {
            "const": "EXACT"
          },
          "priorityRank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "lineage": {
      "type": "object"
    },
    "deterministic": {
      "const": true
    },
    "providerUsed": {
      "const": false
    },
    "aiUsed": {
      "const": false
    },
    "aspectRuntimeCreated": {
      "const": true
    },
    "projectionCreated": {
      "const": false
    },
    "interpretationCreated": {
      "const": false
    },
    "knowledgeCreated": {
      "const": false
    },
    "realityConclusionCreated": {
      "const": false
    },
    "professionalConclusionCreated": {
      "const": false
    },
    "productionEligible": {
      "const": false
    }
  }
}
