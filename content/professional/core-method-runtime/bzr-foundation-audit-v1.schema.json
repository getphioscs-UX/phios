{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/bzr/bzr-foundation-audit-v1.schema.json",
  "title": "PHI OS BZR Foundation Audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stageCode",
    "methodCode",
    "pluginCode",
    "status",
    "baseline",
    "existingGovernance",
    "preservedCandidatePolicies",
    "auditConclusion",
    "blockingFindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-BZR-FOUNDATION-AUDIT-v1.0.0"
    },
    "stageCode": {
      "const": "BZR-W0"
    },
    "methodCode": {
      "const": "BAZI"
    },
    "pluginCode": {
      "const": "BZR"
    },
    "status": {
      "const": "foundation_audited_runtime_not_activated"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "getphioscs-UX/phios"
        },
        "branch": {
          "const": "main"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "existingGovernance": {
      "type": "object"
    },
    "preservedCandidatePolicies": {
      "type": "object"
    },
    "auditConclusion": {
      "type": "object"
    },
    "blockingFindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
