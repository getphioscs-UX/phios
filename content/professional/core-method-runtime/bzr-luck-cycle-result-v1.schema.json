{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/bzr/bzr-luck-cycle-result-v1.schema.json",
  "title": "PHI OS BZR Luck Cycle Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeCode",
    "runtimeVersion",
    "methodCode",
    "pluginCode",
    "calculationType",
    "executionMode",
    "direction",
    "yearStemPolarity",
    "traditionalCalculationSex",
    "traditionalCalculationSexUseScope",
    "birthTrueSolarIso",
    "referenceJie",
    "referenceJieCode",
    "referenceJieUtcIso",
    "intervalSeconds",
    "startAge",
    "cycleDurationYears",
    "cycleCount",
    "cycles",
    "lineage",
    "deterministic",
    "providerUsed",
    "aiUsed",
    "luckCycleCreated",
    "projectionCreated",
    "interpretationCreated",
    "knowledgeCreated",
    "identityInferenceCreated",
    "personalityClaimCreated",
    "relationshipRoleClaimCreated",
    "professionalConclusionCreated",
    "productionEligible"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-BZR-LUCK-CYCLE-RESULT-v1.0.0"
    },
    "runtimeCode": {
      "const": "BZR_LUCK_CYCLE_RUNTIME"
    },
    "runtimeVersion": {
      "const": "1.0.0"
    },
    "methodCode": {
      "const": "BAZI"
    },
    "pluginCode": {
      "const": "BZR"
    },
    "calculationType": {
      "const": "LUCK_CYCLE_SEQUENCE"
    },
    "executionMode": {
      "const": "validation"
    },
    "direction": {
      "enum": [
        "FORWARD",
        "BACKWARD"
      ]
    },
    "yearStemPolarity": {
      "enum": [
        "YANG",
        "YIN"
      ]
    },
    "traditionalCalculationSex": {
      "enum": [
        "MALE",
        "FEMALE"
      ]
    },
    "traditionalCalculationSexUseScope": {
      "const": "LUCK_CYCLE_DIRECTION_ONLY"
    },
    "birthTrueSolarIso": {
      "type": "string",
      "format": "date-time"
    },
    "referenceJie": {
      "enum": [
        "NEXT_JIE",
        "PREVIOUS_JIE"
      ]
    },
    "referenceJieCode": {
      "type": "string",
      "minLength": 1
    },
    "referenceJieUtcIso": {
      "type": "string",
      "format": "date-time"
    },
    "intervalSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "startAge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "years",
        "months",
        "days",
        "totalYearsNumerator",
        "totalYearsDenominator",
        "roundingApplied"
      ],
      "properties": {
        "years": {
          "type": "integer",
          "minimum": 0
        },
        "months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 29
        },
        "totalYearsNumerator": {
          "type": "integer",
          "minimum": 0
        },
        "totalYearsDenominator": {
          "type": "integer",
          "minimum": 1
        },
        "roundingApplied": {
          "const": false
        }
      }
    },
    "cycleDurationYears": {
      "const": 10
    },
    "cycleCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "cycles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cycleNumber",
          "direction",
          "startAgeYears",
          "endAgeYears",
          "pillar"
        ],
        "properties": {
          "cycleNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "direction": {
            "enum": [
              "FORWARD",
              "BACKWARD"
            ]
          },
          "startAgeYears": {
            "type": "integer",
            "minimum": 0
          },
          "endAgeYears": {
            "type": "integer",
            "minimum": 10
          },
          "pillar": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stemCode",
              "branchCode",
              "sexagenaryIndex"
            ],
            "properties": {
              "stemCode": {
                "enum": [
                  "JIA",
                  "YI",
                  "BING",
                  "DING",
                  "WU",
                  "JI",
                  "GENG",
                  "XIN",
                  "REN",
                  "GUI"
                ]
              },
              "branchCode": {
                "enum": [
                  "ZI",
                  "CHOU",
                  "YIN",
                  "MAO",
                  "CHEN",
                  "SI",
                  "WU",
                  "WEI",
                  "SHEN",
                  "YOU",
                  "XU",
                  "HAI"
                ]
              },
              "sexagenaryIndex": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            }
          }
        }
      }
    },
    "lineage": {
      "type": "object"
    },
    "deterministic": {
      "const": true
    },
    "providerUsed": {
      "const": false
    },
    "aiUsed": {
      "const": false
    },
    "luckCycleCreated": {
      "const": true
    },
    "projectionCreated": {
      "const": false
    },
    "interpretationCreated": {
      "const": false
    },
    "knowledgeCreated": {
      "const": false
    },
    "identityInferenceCreated": {
      "const": false
    },
    "personalityClaimCreated": {
      "const": false
    },
    "relationshipRoleClaimCreated": {
      "const": false
    },
    "professionalConclusionCreated": {
      "const": false
    },
    "productionEligible": {
      "const": false
    }
  }
}
