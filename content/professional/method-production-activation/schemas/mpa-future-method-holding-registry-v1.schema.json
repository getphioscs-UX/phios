{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PHI-OS-MPA-W25-FUTURE-METHOD-HOLDING-REGISTRY-v1.schema.json",
  "title": "PHI OS MPA-W25 Future Method Holding Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryCode",
    "registryVersion",
    "work",
    "baselineCommit",
    "status",
    "holdingContract",
    "canonicalMethodRegistry",
    "allowedHoldingStates",
    "entries",
    "futureMethodPolicy"
  ],
  "properties": {
    "registryCode": {"const": "MPA-FUTURE-METHOD-HOLDING-REGISTRY-v1"},
    "registryVersion": {"const": "1.0.0"},
    "work": {"const": "MPA-W25"},
    "baselineCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"const": "ACTIVE_HOLDING_REGISTRY_NO_PRODUCTION_GRANT"},
    "holdingContract": {"type": "string", "minLength": 1},
    "canonicalMethodRegistry": {"type": "string", "minLength": 1},
    "allowedHoldingStates": {
      "type": "array",
      "const": ["DRAFT", "REGISTERED"]
    },
    "entries": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/holdingEntry"}
    },
    "futureMethodPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "additionalFutureMethodsAllowed",
        "draftEntryRequiresCanonicalRegistryBinding",
        "registeredEntryRequiresCanonicalRegistryBinding",
        "productionFromHoldingAllowed",
        "independentActivationRequired",
        "versionedSuccessorRequired"
      ],
      "properties": {
        "additionalFutureMethodsAllowed": {"const": true},
        "draftEntryRequiresCanonicalRegistryBinding": {"const": false},
        "registeredEntryRequiresCanonicalRegistryBinding": {"const": true},
        "productionFromHoldingAllowed": {"const": false},
        "independentActivationRequired": {"const": true},
        "versionedSuccessorRequired": {"const": true}
      }
    }
  },
  "$defs": {
    "canonicalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "methodCode", "pluginCode", "methodVersion", "registryState"],
      "properties": {
        "registry": {"const": "METHOD_REGISTRY_V2"},
        "methodCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "pluginCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "methodVersion": {"type": "string", "minLength": 1},
        "registryState": {"const": "REGISTERED"}
      }
    },
    "holdingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodCode",
        "methodName",
        "pluginCode",
        "holdingState",
        "definitionState",
        "canonicalMethodRegistryBinding",
        "implementationState",
        "activationState",
        "productionEligible",
        "productionExecutionAllowed",
        "professionalEligible",
        "publicEligible",
        "independentActivationRequired",
        "blockingReasons"
      ],
      "properties": {
        "methodCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "methodName": {"type": "string", "minLength": 1},
        "pluginCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "holdingState": {"enum": ["DRAFT", "REGISTERED"]},
        "definitionState": {"enum": ["DRAFT", "REGISTERED"]},
        "canonicalMethodRegistryBinding": {
          "oneOf": [
            {"$ref": "#/$defs/canonicalBinding"},
            {"type": "null"}
          ]
        },
        "implementationState": {"const": "NOT_IMPLEMENTED"},
        "activationState": {"const": "NOT_ACTIVATED"},
        "productionEligible": {"const": false},
        "productionExecutionAllowed": {"const": false},
        "professionalEligible": {"const": false},
        "publicEligible": {"const": false},
        "independentActivationRequired": {"const": true},
        "blockingReasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
