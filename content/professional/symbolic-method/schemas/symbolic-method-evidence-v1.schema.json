{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/symbolic-method/symbolic-method-evidence-v1.schema.json",
  "title": "PHI OS Symbolic Method Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "methodId",
    "sessionId",
    "inputMode",
    "selectionMode",
    "selectionEvidence",
    "timestamp",
    "runtimeVersion",
    "projectionVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-SYMBOLIC-METHOD-EVIDENCE-v1.0.0"
    },
    "methodId": {
      "enum": [
        "I_CHING",
        "TAROT"
      ]
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "inputMode": {
      "type": "string",
      "minLength": 1
    },
    "selectionMode": {
      "enum": [
        "MANUAL_SELECTION",
        "SYSTEM_RANDOM"
      ]
    },
    "selectionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectionOrder",
        "selectedSymbols",
        "runtimeVersion",
        "aiSelected"
      ],
      "properties": {
        "selectionOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "selectedSymbols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtimeVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "aiSelected": {
          "const": false
        },
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "entropyEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "digest"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "replayToken": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "runtimeVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "projectionVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selectionMode": {
            "const": "SYSTEM_RANDOM"
          }
        }
      },
      "then": {
        "properties": {
          "selectionEvidence": {
            "required": [
              "selectionOrder",
              "selectedSymbols",
              "runtimeVersion",
              "aiSelected",
              "seed",
              "entropyEvidence",
              "replayToken"
            ]
          }
        }
      }
    }
  ]
}
