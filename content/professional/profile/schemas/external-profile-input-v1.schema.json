{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phi-os.profile.external-input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "externalProfileId",
    "participantRef",
    "providerFamily",
    "providerName",
    "resultLabel",
    "resultDimensions",
    "assessmentDate",
    "resultPrecision",
    "customerConfirmed",
    "sourceClass",
    "purpose",
    "consent",
    "persistencePreference",
    "provenance",
    "governance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-EXTERNAL-PROFILE-INPUT-v1"
    },
    "externalProfileId": {
      "type": "string",
      "minLength": 1
    },
    "participantRef": {
      "type": "string",
      "minLength": 1
    },
    "providerFamily": {
      "enum": [
        "MBTI_OFFICIAL",
        "16P_NERIS",
        "IPIP_BIG_FIVE",
        "OTHER_BIG_FIVE",
        "OTHER_EXTERNAL_PROFILE"
      ]
    },
    "providerName": {
      "type": "string",
      "minLength": 1
    },
    "resultLabel": {
      "type": "string",
      "minLength": 1
    },
    "resultDimensions": {
      "type": "object"
    },
    "assessmentDate": {
      "type": [
        "string",
        "null"
      ]
    },
    "resultPrecision": {
      "enum": [
        "CONFIRMED",
        "APPROXIMATE",
        "UNKNOWN"
      ]
    },
    "customerConfirmed": {
      "type": "boolean"
    },
    "sourceClass": {
      "const": "EXTERNAL_PROFILE_RESULT"
    },
    "purpose": {
      "const": "PROFILE_CONTEXT"
    },
    "consent": {
      "const": true
    },
    "persistencePreference": {
      "enum": [
        "SESSION_ONLY",
        "SAVE_TO_ACCOUNT",
        "DO_NOT_SAVE"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "governance": {
      "type": "object"
    }
  }
}
