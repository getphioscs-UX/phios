{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/canonical-meaning-runtime/method-to-meaning-mapping-v1.schema.json",
  "title": "PHI OS Method-to-Meaning Mapping Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mappingCode",
    "mappingVersion",
    "sourceMethodCode",
    "sourceProjectionSchemaVersion",
    "projectionType",
    "projectionPredicate",
    "targetMeaningCodes",
    "mappingAuthority",
    "mappingConfidence",
    "boundary",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "mappingCode": {
      "type": "string",
      "pattern": "^MAP-[A-Z][A-Z0-9_]+-[A-Z][A-Z0-9_]+-[A-Z0-9_]+$"
    },
    "mappingVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "sourceMethodCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "sourceProjectionSchemaVersion": {
      "const": "PHI-OS-CANONICAL-PROJECTION-v1.0.0"
    },
    "projectionType": {
      "enum": [
        "GATE",
        "CHANNEL",
        "CENTER",
        "AUTHORITY",
        "PROFILE",
        "PLANET",
        "HOUSE",
        "ASPECT",
        "STEM",
        "BRANCH",
        "PILLAR",
        "LUCK_CYCLE",
        "HEXAGRAM",
        "CARD"
      ]
    },
    "projectionPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicateVersion", "operator", "path", "value"],
      "properties": {
        "predicateVersion": { "const": "1.0.0" },
        "operator": { "enum": ["equals", "in"] },
        "path": {
          "type": "string",
          "pattern": "^projection(Value|Code)(\\.[A-Za-z][A-Za-z0-9_]*)*$"
        },
        "value": {}
      }
    },
    "targetMeaningCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CM-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
      }
    },
    "mappingAuthority": { "const": "PHIOS" },
    "mappingConfidence": {
      "enum": ["proposed", "reviewed", "validated"]
    },
    "boundary": { "const": "validation_only" },
    "status": {
      "enum": ["draft", "validation_only", "deprecated"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
