 :root{color-scheme:light;--navy:#132d43;--teal:#185b61;--gold:#b28b46}*{box-sizing:border-box}body{margin:0;background:#f5f3ed;color:var(--navy);font:17px/1.65 system-ui,sans-serif}main{max-width:1060px;margin:auto;padding:32px 24px}header{border-bottom:1px solid #c9c5b8;padding-bottom:24px}h1{font-size:clamp(30px,5vw,48px);line-height:1.15}h2{font-size:23px;color:var(--teal)}a{color:var(--teal);overflow-wrap:anywhere}button{background:#fff;border:1px solid var(--teal);border-radius:6px;color:var(--teal);padding:11px 15px;font:inherit;cursor:pointer;min-height:44px}button[aria-pressed=true]{background:var(--teal);color:white}:focus-visible{outline:3px solid var(--gold);outline-offset:4px}nav{display:flex;flex-wrap:wrap;gap:9px;margin:22px 0}.panel,article{background:#fff;border:1px solid #d4d9d6;border-radius:10px;padding:22px;margin:18px 0}article{border-left:4px solid var(--teal)}small{display:block;overflow-wrap:anywhere;color:#4e5c64}input{width:19px;height:19px}label{display:flex;gap:10px;align-items:center;cursor:pointer}#state{color:#72581e}#question{font-size:24px}.notice{border-left:4px solid var(--gold);padding:12px 20px}li{margin:14px 0}details{margin:18px 0}summary{cursor:pointer;min-height:44px}#selection-result{min-height:54px}footer{margin:40px 0}@media(max-width:430px){main{padding:20px 16px}.panel,article{padding:16px}nav button{flex:1}#question{font-size:21px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}@media print{button,nav{display:none}body{background:white}.panel,article{break-inside:avoid}}
