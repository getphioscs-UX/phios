{
  "schemaVersion": "PHI-OS-CX-R12R3B-SHARED-REALITY-THEME-REGISTRY-v1.0.0",
  "registryId": "CX-R12R3B-SHARED-REALITY-THEME-REGISTRY-v1",
  "status": "DEVELOPMENT_AUTHORITY",
  "purpose": "Project independently customer-publishable method interpretation units into shared human-readable themes without comparing raw method symbols.",
  "themes": [
    "AUTONOMY",
    "RELATIONSHIP",
    "STABILITY",
    "CHANGE",
    "EXPRESSION",
    "RESPONSIBILITY",
    "BOUNDARY",
    "DIRECTION"
  ],
  "projectionRules": [
    {"ruleRef": "CX-THEME-RELATION-SUPPORT-v1", "relationTypes": ["SUPPORT", "REINFORCEMENT"], "theme": "STABILITY"},
    {"ruleRef": "CX-THEME-RELATION-TENSION-v1", "relationTypes": ["TENSION", "COUNTERBALANCE"], "theme": "BOUNDARY"},
    {"ruleRef": "CX-THEME-RELATION-MOTION-v1", "relationTypes": ["ACTIVATION", "TRANSITION"], "theme": "CHANGE"},
    {"ruleRef": "CX-THEME-RELATION-DEPENDENCY-v1", "relationTypes": ["DEPENDENCY"], "theme": "RESPONSIBILITY"},
    {"ruleRef": "CX-THEME-RELATION-REPETITION-v1", "relationTypes": ["REPETITION"], "theme": "DIRECTION"}
  ],
  "reservedThemes": ["AUTONOMY", "RELATIONSHIP", "EXPRESSION"],
  "reservedThemePolicy": "A reserved theme requires a future versioned projection rule and cannot be inferred from raw symbols or free text.",
  "inputBoundary": {
    "requiresExactlyFourUniqueMethods": true,
    "requiredMethods": ["AST", "NUM", "BZR", "ZWR"],
    "requiresCustomerPublishableInterpretationResult": true,
    "rawMethodSymbolsForbidden": true
  },
  "requiredLineage": ["methodSource", "interpretationUnitRefs", "projectionRefs", "registryRuleRef", "sourceSemanticDigest"],
  "mayCreateUnifiedPersonalityConclusion": false,
  "workCoverage": ["56A"]
}
