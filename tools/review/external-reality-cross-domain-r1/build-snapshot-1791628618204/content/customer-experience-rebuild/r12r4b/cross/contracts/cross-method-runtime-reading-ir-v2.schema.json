{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/cross-method-runtime-reading-ir-v2.schema.json",
  "title": "PHI OS Cross Method Runtime Reading IR v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceInputDigest", "semanticMatrixDigest", "claims", "uncomposedDimensions", "technical", "boundaries", "readingDigest"],
  "properties": {
    "schemaVersion": {"const": "PHI-OS-CROSS-METHOD-RUNTIME-READING-IR-v2.0.0"},
    "sourceInputDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semanticMatrixDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "semanticDimension", "headline", "narrative", "methodRefs", "claimRefs", "evidenceRefs", "supportType", "tensionRefs", "boundary", "lineage"],
        "properties": {
          "claimId": {"type": "string", "pattern": "^CROSS-CLAIM-"},
          "semanticDimension": {"type": "string", "minLength": 1},
          "headline": {"type": "string", "minLength": 1},
          "narrative": {"type": "string", "minLength": 1},
          "methodRefs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["AST", "BZR", "ZWR", "NUM", "ECR"]}},
          "claimRefs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
          "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "supportType": {"enum": ["COMMON", "COMPLEMENTARY", "TENSION", "CONTEXT_DEPENDENT", "OPEN"]},
          "tensionRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "boundary": {"type": "object"},
          "lineage": {"type": "object"}
        }
      }
    },
    "uncomposedDimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "technical": {"type": "object"},
    "boundaries": {"type": "object"},
    "readingDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
