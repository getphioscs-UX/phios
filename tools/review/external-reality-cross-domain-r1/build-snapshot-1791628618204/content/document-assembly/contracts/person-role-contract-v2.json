{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/dar/person-role-contract-v2.json",
  "title": "DAR persisted declared person role v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["personId", "fullName", "idType", "identityCaptureState", "addressCaptureState", "roles"],
  "properties": {
    "personId": {"type":"string","minLength":1,"maxLength":128},
    "fullName": {"type":"string","minLength":1,"maxLength":200},
    "idType": {"enum":["NATIONAL_ID","PASSPORT","OTHER","UNKNOWN"]},
    "identityCaptureState": {"enum":["NOT_PROVIDED","FINALIZATION_REQUIRED","REFERENCE_ONLY"]},
    "identityReferenceLast4": {"type":"string","pattern":"^[A-Za-z0-9]{4}$"},
    "address": {"type":"string","minLength":1,"maxLength":1000},
    "addressCaptureState": {"enum":["CUSTOMER_DECLARED","NOT_PROVIDED","DECLINED"]},
    "relationship": {"type":"string","maxLength":100},
    "contact": {"type":"string","maxLength":300},
    "nationality": {"type":"string","maxLength":100},
    "dateOfBirth": {"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "roles": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["TESTATOR","EXECUTOR","SUBSTITUTE_EXECUTOR","GUARDIAN","SUBSTITUTE_GUARDIAN","BENEFICIARY","SUBSTITUTE_BENEFICIARY","WITNESS","DIGITAL_FACILITATOR","TRANSLATOR"]}}
  },
  "allOf": [
    {"if":{"properties":{"addressCaptureState":{"const":"CUSTOMER_DECLARED"}}},"then":{"required":["address"]},"else":{"not":{"required":["address"]}}},
    {"if":{"properties":{"identityCaptureState":{"const":"REFERENCE_ONLY"}}},"then":{"required":["identityReferenceLast4"]},"else":{"not":{"required":["identityReferenceLast4"]}}}
  ],
  "x-phi-os": {
    "work":"FW-S1", "authorityOwner":"DAR",
    "predecessor":"content/document-assembly/contracts/person-role-contract-v1.json",
    "successorUse":"EXPLICIT_V2_CONSUMERS_ONLY",
    "v1Unchanged":true,
    "roleDoesNotCreateLegalAppointment":true,
    "fullIdentityNumberPersisted":false,
    "fullIdentityNumberMayBeFinalizationOnly":true
  }
}
