{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/bzr/bzr-projection-bundle-v1.schema.json",
  "title": "PHI OS BZR Projection Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeCode",
    "runtimeVersion",
    "methodCode",
    "pluginCode",
    "executionMode",
    "projectionVersion",
    "normalizedFactsReference",
    "sourceCalculations",
    "projections",
    "deterministic",
    "providerUsed",
    "aiUsed",
    "projectionCreated",
    "interpretationCreated",
    "knowledgeCreated",
    "realityConclusionCreated",
    "professionalConclusionCreated",
    "productionEligible"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-BZR-PROJECTION-BUNDLE-v1.0.0"
    },
    "runtimeCode": {
      "const": "BZR_PROJECTION_RUNTIME"
    },
    "runtimeVersion": {
      "const": "1.0.0"
    },
    "methodCode": {
      "const": "BAZI"
    },
    "pluginCode": {
      "const": "BZR"
    },
    "executionMode": {
      "const": "validation"
    },
    "projectionVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "normalizedFactsReference": {
      "type": "object"
    },
    "sourceCalculations": {
      "type": "object"
    },
    "projections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "../../method-runtime/canonical-projection-v1.schema.json"
        },
        {
          "$ref": "../../method-runtime/canonical-projection-v1.schema.json"
        },
        {
          "$ref": "../../method-runtime/canonical-projection-v1.schema.json"
        },
        {
          "$ref": "../../method-runtime/canonical-projection-v1.schema.json"
        }
      ],
      "items": false
    },
    "deterministic": {
      "const": true
    },
    "providerUsed": {
      "const": false
    },
    "aiUsed": {
      "const": false
    },
    "projectionCreated": {
      "const": true
    },
    "interpretationCreated": {
      "const": false
    },
    "knowledgeCreated": {
      "const": false
    },
    "realityConclusionCreated": {
      "const": false
    },
    "professionalConclusionCreated": {
      "const": false
    },
    "productionEligible": {
      "const": false
    }
  }
}
