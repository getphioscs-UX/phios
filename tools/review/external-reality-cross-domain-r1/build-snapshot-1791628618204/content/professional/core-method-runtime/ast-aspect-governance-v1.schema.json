{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/ast/ast-aspect-governance-v1.schema.json",
  "title": "PHI OS AST Aspect Governance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stageCode",
    "governanceCode",
    "governanceVersion",
    "methodCode",
    "pluginCode",
    "status",
    "baseline",
    "authority",
    "aspectRegistry",
    "aspectSets",
    "orbPolicies",
    "applyingPolicies",
    "priorityPolicies",
    "normalizationPolicy",
    "validationBoundary",
    "runtimeContract",
    "boundaries",
    "nextStage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-AST-ASPECT-GOVERNANCE-v1.0.0"
    },
    "stageCode": {
      "const": "AST-W4A"
    },
    "governanceCode": {
      "const": "AST_ASPECT_GOVERNANCE"
    },
    "governanceVersion": {
      "const": "1.0.0"
    },
    "methodCode": {
      "const": "ASTROLOGY"
    },
    "pluginCode": {
      "const": "AST"
    },
    "status": {
      "const": "governance_frozen_runtime_not_started"
    },
    "baseline": {
      "type": "object",
      "required": [
        "repository",
        "branch",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "getphioscs-UX/phios"
        },
        "branch": {
          "const": "main"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "authority": {
      "type": "object"
    },
    "aspectRegistry": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aspectCode",
          "angleDegrees",
          "category",
          "symmetry",
          "status"
        ],
        "properties": {
          "aspectCode": {
            "enum": [
              "CONJUNCTION",
              "SEXTILE",
              "SQUARE",
              "TRINE",
              "OPPOSITION"
            ]
          },
          "angleDegrees": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "category": {
            "const": "major"
          },
          "symmetry": {
            "const": "unordered_pair"
          },
          "status": {
            "const": "registered"
          }
        }
      }
    },
    "aspectSets": {
      "type": "array",
      "minItems": 1
    },
    "orbPolicies": {
      "type": "array",
      "minItems": 1
    },
    "applyingPolicies": {
      "type": "array",
      "minItems": 1
    },
    "priorityPolicies": {
      "type": "array",
      "minItems": 1
    },
    "normalizationPolicy": {
      "type": "object"
    },
    "validationBoundary": {
      "type": "object"
    },
    "runtimeContract": {
      "type": "object"
    },
    "boundaries": {
      "type": "object"
    },
    "nextStage": {
      "const": "AST-W4B"
    }
  }
}
