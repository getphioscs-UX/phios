{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/mpa/mpa-birth-initialization-data-v1.schema.json",
  "title": "PHI OS MPA Birth Initialization Data v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "initializationId",
    "subjectReference",
    "methodCode",
    "birthDate",
    "birthTime",
    "birthPlace",
    "timezone",
    "coordinates",
    "inputPrecision",
    "source",
    "customerConfirmation",
    "fabricatedDefaultsUsed",
    "calculationFactCreated",
    "projectionCreated",
    "interpretationCreated"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-MPA-BIRTH-INITIALIZATION-DATA-v1.0.0"
    },
    "initializationId": {
      "type": "string",
      "minLength": 3
    },
    "subjectReference": {
      "type": "string",
      "minLength": 1
    },
    "methodCode": {
      "type": "string",
      "minLength": 1
    },
    "birthDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "precision"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "precision": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        }
      }
    },
    "birthTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "precision"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
        },
        "precision": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        }
      }
    },
    "birthPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "precision"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "precision": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        }
      }
    },
    "timezone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ianaZoneId",
        "precision",
        "resolutionStatus"
      ],
      "properties": {
        "ianaZoneId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z_+\\-]+(?:/[A-Za-z0-9_+\\-]+)+$"
        },
        "precision": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        },
        "resolutionStatus": {
          "enum": [
            "DECLARED",
            "UNKNOWN"
          ]
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "elevationM",
        "accuracyM",
        "precision",
        "resolutionStatus"
      ],
      "properties": {
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "elevationM": {
          "type": [
            "number",
            "null"
          ]
        },
        "accuracyM": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "precision": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        },
        "resolutionStatus": {
          "enum": [
            "DECLARED",
            "UNKNOWN"
          ]
        }
      }
    },
    "inputPrecision": {
      "type": "object"
    },
    "source": {
      "type": "object"
    },
    "customerConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed",
        "confirmedAt"
      ],
      "properties": {
        "confirmed": {
          "type": "boolean"
        },
        "confirmedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "fabricatedDefaultsUsed": {
      "const": false
    },
    "calculationFactCreated": {
      "const": false
    },
    "projectionCreated": {
      "const": false
    },
    "interpretationCreated": {
      "const": false
    }
  }
}
