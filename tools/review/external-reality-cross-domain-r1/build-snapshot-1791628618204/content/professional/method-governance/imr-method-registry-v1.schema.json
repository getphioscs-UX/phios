{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/imr-method-governance-registry-v1.schema.json",
  "title": "PHI OS IMR Method Governance Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stageCode",
    "registryCode",
    "registryVersion",
    "status",
    "baseline",
    "authority",
    "runtimeAuthority",
    "runtimeRegistryReference",
    "capabilityModelReference",
    "foundationAuditReference",
    "requiredFields",
    "governancePolicy",
    "methods"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-IMR-METHOD-GOVERNANCE-REGISTRY-v1.0.0"
    },
    "stageCode": {
      "const": "IMR-W1"
    },
    "registryCode": {
      "const": "IMR_METHOD_REGISTRY"
    },
    "registryVersion": {
      "const": "1.0.0"
    },
    "status": {
      "const": "active_governance_registry"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "getphioscs-UX/phios"
        },
        "branch": {
          "const": "main"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "authority": {
      "const": "INTERPRETIVE_METHOD_GOVERNANCE"
    },
    "runtimeAuthority": {
      "const": false
    },
    "runtimeRegistryReference": {
      "type": "string"
    },
    "capabilityModelReference": {
      "type": "string"
    },
    "foundationAuditReference": {
      "type": "string"
    },
    "requiredFields": {
      "const": [
        "methodCode",
        "owner",
        "version",
        "status",
        "capabilities",
        "dependencies"
      ]
    },
    "governancePolicy": {
      "type": "object"
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/method"
      }
    }
  },
  "$defs": {
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodCode",
        "methodName",
        "owner",
        "version",
        "status",
        "capabilities",
        "dependencies",
        "productionEligible"
      ],
      "properties": {
        "methodCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,31}$"
        },
        "methodName": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorityType",
            "ownerCode",
            "implementationTrack"
          ],
          "properties": {
            "authorityType": {
              "const": "HUMAN_GOVERNANCE"
            },
            "ownerCode": {
              "type": "string",
              "minLength": 1
            },
            "implementationTrack": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "draft",
            "experimental",
            "internal",
            "pilot",
            "production",
            "deprecated",
            "archived"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Definition",
              "Data",
              "Calculation",
              "Projection",
              "Interpretation",
              "Professional"
            ]
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtimeRegistryMethodCode",
            "pluginCode",
            "governanceAuditTracks",
            "sharedRuntimeDependencies",
            "externalDependencies",
            "methodDependencies"
          ],
          "properties": {
            "runtimeRegistryMethodCode": {
              "type": "string"
            },
            "pluginCode": {
              "type": "string"
            },
            "governanceAuditTracks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "sharedRuntimeDependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "externalDependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "methodDependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "productionEligible": {
          "const": false
        }
      }
    }
  }
}
