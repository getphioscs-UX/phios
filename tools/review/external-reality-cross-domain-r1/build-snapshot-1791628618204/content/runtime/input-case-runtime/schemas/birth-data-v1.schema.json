{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/icr/birth-data-v1.schema.json",
  "title": "PHI OS ICR Birth Data v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "birthDataVersion",
    "localDate",
    "localTime",
    "precision",
    "calendarCode",
    "placeName",
    "sourceTimezoneText",
    "uncertaintyMinutes",
    "coordinate",
    "subjectConfirmed",
    "evidenceReferences"
  ],
  "properties": {
    "birthDataVersion": {"const": "1.0.0"},
    "localDate": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "localTime": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"},
    "precision": {"enum": ["exact", "minute", "hour", "date_only", "estimated", "unknown"]},
    "calendarCode": {"type": "string", "minLength": 1},
    "placeName": {"type": ["string", "null"], "minLength": 1},
    "sourceTimezoneText": {"type": ["string", "null"], "minLength": 1},
    "uncertaintyMinutes": {"type": ["integer", "null"], "minimum": 0},
    "coordinate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude", "datum", "sourceMethod"],
          "properties": {
            "latitude": {"type": "number", "minimum": -90, "maximum": 90},
            "longitude": {"type": "number", "minimum": -180, "maximum": 180},
            "datum": {"const": "WGS84"},
            "sourceMethod": {"enum": ["DECLARED_PLACE_GEOCODE", "VERIFIED_GEOCODE", "MEASURED"]}
          }
        }
      ]
    },
    "subjectConfirmed": {"type": "boolean"},
    "evidenceReferences": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"precision": {"const": "date_only"}}, "required": ["precision"]},
      "then": {"properties": {"localTime": {"const": null}}}
    },
    {
      "if": {"properties": {"precision": {"enum": ["exact", "minute", "hour", "estimated"]}}, "required": ["precision"]},
      "then": {
        "properties": {
          "localDate": {"type": "string"},
          "localTime": {"type": "string"},
          "placeName": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"precision": {"const": "unknown"}}, "required": ["precision"]},
      "then": {"properties": {"localTime": {"const": null}, "uncertaintyMinutes": {"const": null}}}
    }
  ]
}
