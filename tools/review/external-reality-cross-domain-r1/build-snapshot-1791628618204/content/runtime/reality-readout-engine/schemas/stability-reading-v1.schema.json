{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PHI OS RRE Stability Reading v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stabilityReadingCode",
    "realityReference",
    "stabilityState",
    "descriptorCode",
    "observableReferences",
    "signatureReferences",
    "patternReferences",
    "supportReferences",
    "diagnosisCreated",
    "professionalJudgmentCreated",
    "navigationDecisionCreated",
    "validationOnly",
    "persistentStoreWriteAllowed",
    "stabilityReadingDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-RRE-STABILITY-READING-v1.0.0"
    },
    "stabilityReadingCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "realityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "version",
        "digest"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "stabilityState": {
      "enum": [
        "STABLE",
        "CONDITIONALLY_STABLE",
        "FRAGILE",
        "UNSTABLE",
        "UNKNOWN"
      ]
    },
    "descriptorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "observableReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "signatureReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "patternReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "supportReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "diagnosisCreated": {
      "const": false
    },
    "professionalJudgmentCreated": {
      "const": false
    },
    "navigationDecisionCreated": {
      "const": false
    },
    "validationOnly": {
      "const": true
    },
    "persistentStoreWriteAllowed": {
      "const": false
    },
    "stabilityReadingDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
