{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PHI OS RRE Recovery Reading v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recoveryReadingCode",
    "realityReference",
    "availableRecoveryCapacity",
    "recentRecoverySignal",
    "recoveryConstraints",
    "recoveryWindow",
    "uncertainty",
    "treatmentAdviceCreated",
    "medicalDiagnosisCreated",
    "professionalJudgmentCreated",
    "navigationActionCreated",
    "validationOnly",
    "persistentStoreWriteAllowed",
    "recoveryReadingDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-RRE-RECOVERY-READING-v1.0.0"
    },
    "recoveryReadingCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "realityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "version",
        "digest"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "availableRecoveryCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observableReferences",
        "patternReferences",
        "constraintReferences",
        "supportReferences"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observableReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "patternReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "constraintReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "supportReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "recentRecoverySignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observableReferences",
        "patternReferences",
        "constraintReferences",
        "supportReferences"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observableReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "patternReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "constraintReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "supportReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "recoveryConstraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "recoveryWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observableReferences",
        "patternReferences",
        "constraintReferences",
        "supportReferences"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observableReferences": {
          "type": "array",
          "uniqueItems": true,
