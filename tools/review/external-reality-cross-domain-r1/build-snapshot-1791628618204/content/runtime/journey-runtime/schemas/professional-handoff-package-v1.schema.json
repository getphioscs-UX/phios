    "journeyReference": {
      "type": "string"
    },
    "realityReferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "readoutReferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidenceReferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unknownReferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "consentReferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "journeyContextReference": {
      "type": "string"
    },
    "customerQuestionReference": {
      "type": "string"
    },
    "dataPurpose": {
