  "conditionalCriteria": {
    "FIGURE_CAPTION": "PASS when every rendered <figure> with meaningful visual content has figcaption or an explicit labelled/described relation; NOT_APPLICABLE when no rendered figure exists.",
    "LONG_DESCRIPTION_WHERE_NEEDED": "Figure surface must expose textual explanation/caption/description relation for its governed figure; other surfaces are NOT_APPLICABLE unless a complex governed figure is rendered.",
    "ERROR_IDENTIFICATION": "PASS when rendered error/invalid states are programmatically identified; NOT_APPLICABLE when no error or invalid state is rendered.",
    "ARIA_CURRENT": "PASS when current-state navigation exists and uses valid aria-current; NOT_APPLICABLE when no current-state navigation item is rendered.",
    "ARIA_EXPANDED": "PASS for rendered disclosure controls with valid boolean aria-expanded and resolvable aria-controls when supplied; NOT_APPLICABLE when no disclosure control is rendered.",
    "DIALOG_SEMANTICS": "PASS for rendered dialogs with role/dialog semantics and accessible name; NOT_APPLICABLE when no dialog is rendered.",
    "INTERACTIVE_FIGURE_KEYBOARD_ACCESSIBILITY": "Figure surface is evaluated when interactive figure controls exist; NOT_APPLICABLE for static figures.",
    "ANSWER_EXPANDABLE_REGIONS_ACCESSIBLE": "Ask PHI OS is evaluated when expandable answer regions are rendered; NOT_APPLICABLE before an answer/disclosure exists."
  },
