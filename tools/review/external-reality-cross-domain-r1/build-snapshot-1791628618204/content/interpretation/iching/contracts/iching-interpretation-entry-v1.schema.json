{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/iching/iching-interpretation-entry-v1.schema.json",
  "title": "PHI OS I Ching Source-bound Interpretation Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimId",
    "hexagramId",
    "sourceId",
    "perspectiveId",
    "claim",
    "scope",
    "provenance"
  ],
  "properties": {
    "claimId": {
      "type": "string",
      "pattern": "^ICH-CLM-"
    },
    "hexagramId": {
      "type": "string",
      "pattern": "^HEXAGRAM-(0[1-9]|[1-5][0-9]|6[0-4])$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^ICH-SRC-"
    },
    "perspectiveId": {
      "type": "string",
      "pattern": "^ICH-PERSPECTIVE-"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "HEXAGRAM",
        "LINE",
        "HEXAGRAM_COMMENTARY"
      ]
    },
    "linePosition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "provenance": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "LINE"
          }
        }
      },
      "then": {
        "required": [
          "linePosition"
        ]
      }
    }
  ]
}
