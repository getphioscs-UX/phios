        "explanatory model",
        "scope boundary"
      ],
      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-010-EN-ARTICLE-S03-P02",
      "nodeCode": "KN-PREFACE-010",
      "articleCode": "KA-PREFACE-010-EN-ARTICLE",
      "locale": "en",
      "heading": "From outcome narrative to reality position",
      "text": "This is often slower than delivering an immediate conclusion, but it reduces system-level mismatch. A local pattern is less likely to become a universal rule, and a short-term state is less likely to be rewritten as a permanent identity.",
      "sequence": 202,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S07"
      ],
      "themeCode": "TH-PREFACE-05",
