      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-010-EN-ARTICLE-S04-P01",
      "nodeCode": "KN-PREFACE-010",
      "articleCode": "KA-PREFACE-010-EN-ARTICLE",
      "locale": "en",
      "heading": "Understanding is continuous work",
      "text": "Reality changes, evidence accumulates, and models can fail. Understanding is therefore not a state acquired once; it is an activity that can be updated.",
      "sequence": 301,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S07"
      ],
      "themeCode": "TH-PREFACE-05",
      "collectionCode": "KC-PREFACE",
      "previousNode": "KN-PREFACE-005",
      "nextNode": "KN-PREFACE-011",
      "relatedNodes": [
        "KN-PREFACE-004",
        "KN-PREFACE-011",
        "KN-PREFACE-013"
      ],
      "keywords": [
        "alternative explanations",
        "evidence selection",
        "explanatory model",
        "scope boundary"
      ],
      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-010-EN-ARTICLE-S04-P02",
      "nodeCode": "KN-PREFACE-010",
      "articleCode": "KA-PREFACE-010-EN-ARTICLE",
      "locale": "en",
      "heading": "Understanding is continuous work",
      "text": "Good explanations remain useful, but they should carry their source, range, counterexamples, and review conditions. Only then can an explanation become part of navigation rather than its endpoint.",
      "sequence": 302,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S07"
      ],
      "themeCode": "TH-PREFACE-05",
      "collectionCode": "KC-PREFACE",
