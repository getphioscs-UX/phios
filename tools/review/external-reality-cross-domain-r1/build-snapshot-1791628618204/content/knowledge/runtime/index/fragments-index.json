      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-013-EN-ARTICLE-S01-P01",
      "nodeCode": "KN-PREFACE-013",
      "articleCode": "KA-PREFACE-013-EN-ARTICLE",
      "locale": "en",
      "heading": "Without an origin, direction is abstract",
      "text": "Forward, improvement, and transformation sound directional, but none states the starting point. The same destination can imply very different paths, costs, and risks from different origins.",
      "sequence": 1,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S11"
      ],
      "themeCode": "TH-PREFACE-06",
      "collectionCode": "KC-PREFACE",
      "previousNode": "KN-PREFACE-012",
      "nextNode": null,
      "relatedNodes": [
        "KN-PREFACE-004",
        "KN-PREFACE-010",
        "KN-PREFACE-012"
      ],
      "keywords": [
        "constraints and resources",
        "feedback update",
        "navigation origin",
        "reality position"
      ],
      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-013-EN-ARTICLE-S01-P02",
      "nodeCode": "KN-PREFACE-013",
      "articleCode": "KA-PREFACE-013-EN-ARTICLE",
      "locale": "en",
      "heading": "Without an origin, direction is abstract",
      "text": "Navigation requires at least a time-bounded origin, a describable destination, current constraints, available resources, and a way to observe change after action. Without them, path comparison can collapse into preference comparison.",
      "sequence": 2,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S11"
      ],
      "themeCode": "TH-PREFACE-06",
      "collectionCode": "KC-PREFACE",
      "previousNode": "KN-PREFACE-012",
      "nextNode": null,
      "relatedNodes": [
        "KN-PREFACE-004",
        "KN-PREFACE-010",
        "KN-PREFACE-012"
      ],
      "keywords": [
        "constraints and resources",
        "feedback update",
        "navigation origin",
        "reality position"
      ],
      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-013-EN-ARTICLE-S02-P01",
      "nodeCode": "KN-PREFACE-013",
      "articleCode": "KA-PREFACE-013-EN-ARTICLE",
      "locale": "en",
      "heading": "Reality position is not an identity label",
      "text": "Reality position describes a state within a scope, at a time, and under a body of evidence. It can include active relationships, changes already underway, unresolved constraints, and resources that can be mobilized.",
      "sequence": 101,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S11"
      ],
      "themeCode": "TH-PREFACE-06",
      "collectionCode": "KC-PREFACE",
      "previousNode": "KN-PREFACE-012",
      "nextNode": null,
      "relatedNodes": [
        "KN-PREFACE-004",
        "KN-PREFACE-010",
        "KN-PREFACE-012"
      ],
      "keywords": [
        "constraints and resources",
        "feedback update",
        "navigation origin",
        "reality position"
      ],
      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-013-EN-ARTICLE-S02-P02",
      "nodeCode": "KN-PREFACE-013",
      "articleCode": "KA-PREFACE-013-EN-ARTICLE",
      "locale": "en",
      "heading": "Reality position is not an identity label",
      "text": "It does not turn a temporary state into a permanent identity or expand one dimension into a judgment of the whole. A position should change when new evidence appears. That updateability is central to its credibility.",
      "sequence": 102,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S11"
      ],
      "themeCode": "TH-PREFACE-06",
      "collectionCode": "KC-PREFACE",
      "previousNode": "KN-PREFACE-012",
      "nextNode": null,
      "relatedNodes": [
        "KN-PREFACE-004",
        "KN-PREFACE-010",
        "KN-PREFACE-012"
      ],
      "keywords": [
        "constraints and resources",
        "feedback update",
        "navigation origin",
        "reality position"
      ],
      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-013-EN-ARTICLE-S03-P01",
      "nodeCode": "KN-PREFACE-013",
      "articleCode": "KA-PREFACE-013-EN-ARTICLE",
      "locale": "en",
      "heading": "How position supports path comparison",
      "text": "Once an origin is explicit, paths can be compared under common conditions: what each requires, which relationships it changes, what risks it exposes, and when feedback should become observable.",
      "sequence": 201,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S11"
      ],
      "themeCode": "TH-PREFACE-06",
      "collectionCode": "KC-PREFACE",
      "previousNode": "KN-PREFACE-012",
      "nextNode": null,
      "relatedNodes": [
        "KN-PREFACE-004",
        "KN-PREFACE-010",
        "KN-PREFACE-012"
      ],
      "keywords": [
        "constraints and resources",
        "feedback update",
        "navigation origin",
        "reality position"
      ],
      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-013-EN-ARTICLE-S03-P02",
      "nodeCode": "KN-PREFACE-013",
      "articleCode": "KA-PREFACE-013-EN-ARTICLE",
      "locale": "en",
      "heading": "How position supports path comparison",
      "text": "This does not imply that one optimal path always exists. Reality navigation more often selects a bounded, reversible, or reviewable next step and uses feedback to reduce what remains unknown.",
      "sequence": 202,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S11"
      ],
      "themeCode": "TH-PREFACE-06",
      "collectionCode": "KC-PREFACE",
      "previousNode": "KN-PREFACE-012",
      "nextNode": null,
      "relatedNodes": [
        "KN-PREFACE-004",
        "KN-PREFACE-010",
        "KN-PREFACE-012"
      ],
      "keywords": [
        "constraints and resources",
        "feedback update",
        "navigation origin",
        "reality position"
      ],
      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-013-EN-ARTICLE-S04-P01",
      "nodeCode": "KN-PREFACE-013",
      "articleCode": "KA-PREFACE-013-EN-ARTICLE",
      "locale": "en",
      "heading": "Navigation ends—and begins again—with relocation",
      "text": "Action changes reality and can reveal relationships that were previously invisible. A navigation cycle therefore does not end with execution; it re-establishes position through new observation.",
      "sequence": 301,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S11"
      ],
      "themeCode": "TH-PREFACE-06",
      "collectionCode": "KC-PREFACE",
      "previousNode": "KN-PREFACE-012",
      "nextNode": null,
      "relatedNodes": [
        "KN-PREFACE-004",
        "KN-PREFACE-010",
        "KN-PREFACE-012"
      ],
      "keywords": [
        "constraints and resources",
        "feedback update",
        "navigation origin",
        "reality position"
      ],
      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-013-EN-ARTICLE-S04-P02",
      "nodeCode": "KN-PREFACE-013",
      "articleCode": "KA-PREFACE-013-EN-ARTICLE",
      "locale": "en",
      "heading": "Navigation ends—and begins again—with relocation",
      "text": "Detect change, reconstruct position, compare paths, take a bounded action, receive feedback, and locate again. Direction then becomes a relationship that updates with reality rather than a fixed slogan.",
      "sequence": 302,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S11"
      ],
      "themeCode": "TH-PREFACE-06",
