        "KN-PREFACE-010",
        "KN-PREFACE-012"
      ],
      "keywords": [
        "constraints and resources",
        "feedback update",
        "navigation origin",
        "reality position"
      ],
      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-013-ZH-ARTICLE-S01-P01",
      "nodeCode": "KN-PREFACE-013",
      "articleCode": "KA-PREFACE-013-ZH-ARTICLE",
      "locale": "zh-Hans",
      "heading": "没有起点，方向只是抽象词",
      "text": "“向前”“改善”或“转型”听起来像方向，但它们并不说明从哪里出发。相同目标对于不同起点可能意味着完全不同的路径、成本和风险。",
      "sequence": 1,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S11"
      ],
      "themeCode": "TH-PREFACE-06",
      "collectionCode": "KC-PREFACE",
      "previousNode": "KN-PREFACE-012",
      "nextNode": null,
      "relatedNodes": [
        "KN-PREFACE-004",
        "KN-PREFACE-010",
        "KN-PREFACE-012"
      ],
      "keywords": [
        "反馈更新",
        "导航起点",
        "现实位置",
        "约束与资源"
      ],
      "aliases": []
    },
    {
      "fragmentCode": "KA-PREFACE-013-ZH-ARTICLE-S01-P02",
      "nodeCode": "KN-PREFACE-013",
      "articleCode": "KA-PREFACE-013-ZH-ARTICLE",
      "locale": "zh-Hans",
      "heading": "没有起点，方向只是抽象词",
      "text": "导航至少需要一个时间明确的起点、一个可描述的目标、当前约束、可用资源，以及行动后如何观察变化。缺少这些要素时，路径比较很容易退化为偏好比较。",
      "sequence": 2,
      "fragmentType": "article_paragraph",
      "publicStatus": "published",
      "claimCodes": [],
      "sourceCodes": [
        "SRC-PREFACE-S11"
      ],
      "themeCode": "TH-PREFACE-06",
