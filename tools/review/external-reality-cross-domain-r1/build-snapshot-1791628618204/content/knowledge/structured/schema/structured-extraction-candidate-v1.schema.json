{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unapproved structured extraction candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidateId",
    "bookCode",
    "partCode",
    "nodeCode",
    "manuscriptRef",
    "candidateType",
    "proposedTitle",
    "proposedMeaning",
    "meaningKind",
    "proposedRelationships",
    "sourceQuoteRefs",
    "confidence",
    "reviewState",
    "sourceObjectId",
    "sourceRegistry",
    "executionClass",
    "aiInvoked",
    "canonicalAuthority",
    "extractionOrder"
  ],
  "properties": {
    "candidateId": {
      "type": "string",
      "pattern": "^EXTRACT-SK-B[1-4]-[A-Z0-9-]+-V1$"
    },
    "bookCode": {
      "enum": [
        "BOOK-1",
        "BOOK-2",
        "BOOK-3",
        "BOOK-4"
      ]
    },
    "partCode": {
      "type": "string",
      "pattern": "^P[0-9]+$"
    },
    "nodeCode": {
      "type": "string",
      "minLength": 1
    },
    "manuscriptRef": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sectionCode",
          "startPage",
          "endPage",
          "textSha256",
          "rawDeliveryAllowed"
        ],
        "properties": {
          "sectionCode": {
            "type": "string",
            "minLength": 1
          },
          "startPage": {
            "type": "integer",
            "minimum": 1
          },
          "endPage": {
            "type": "integer",
            "minimum": 1
          },
          "textSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rawDeliveryAllowed": {
            "const": false
          }
        }
      }
    },
    "candidateType": {
      "enum": [
        "MECHANISM",
        "STATE",
        "SIGNAL",
        "CONDITION",
        "BOUNDARY",
        "CONSTRAINT",
        "PRESSURE",
        "CAPACITY",
        "LOAD",
        "PATTERN",
        "RELATIONSHIP",
        "DEPENDENCY",
        "FEEDBACK",
        "TRANSITION",
        "THRESHOLD",
        "FAILURE_MODE",
        "RECOVERY_MODE",
        "EXPANSION_MODE",
        "SCALE_SHIFT",
        "CARRIER",
        "RESOURCE",
        "COORDINATION_MODE",
        "CONTINUITY_MODE",
        "OBSERVATION_CUE"
      ]
    },
    "proposedTitle": {
      "type": "string",
      "minLength": 1
    },
    "proposedMeaning": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "meaningKind": {
      "enum": [
        "SOURCE_DEFINITION",
        "PUBLISHED_ARTICLE_SUMMARY",
        "UNRESOLVED"
      ]
    },
    "proposedRelationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetCandidateId",
          "relationType",
          "sourceQuoteRefs"
        ],
        "properties": {
          "targetCandidateId": {
            "type": "string",
            "minLength": 1
          },
          "relationType": {
            "type": "string",
            "minLength": 1
          },
          "sourceQuoteRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "pointer",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "sourceQuoteRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "pointer",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "confidence": {
      "enum": [
        "SOURCE_BOUND",
        "UNRESOLVED"
      ]
    },
    "reviewState": {
      "const": "PENDING_HUMAN_REVIEW"
    },
    "sourceObjectId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRegistry": {
      "type": "string",
      "minLength": 1
    },
    "executionClass": {
      "enum": [
        "T0_DETERMINISTIC",
        "T1_CANONICAL_ASSEMBLY",
        "T2_LIGHT_COMPOSITION",
        "T3_DEEP_COMPOSITION"
      ]
    },
    "aiInvoked": {
      "type": "boolean"
    },
    "canonicalAuthority": {
      "const": false
    },
    "extractionOrder": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "path"
        ],
        "properties": {
          "stage": {
            "enum": [
              "CANONICAL_NODE_METADATA",
              "EXISTING_BLUEPRINT",
              "APPROVED_MAPPING",
              "MANUSCRIPT_HEADINGS",
              "EXISTING_FIGURE_METADATA"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "proposedMeaning": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "confidence": {
            "const": "UNRESOLVED"
          },
          "meaningKind": {
            "const": "UNRESOLVED"
          },
          "sourceQuoteRefs": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "confidence": {
            "const": "SOURCE_BOUND"
          },
          "meaningKind": {
            "enum": [
              "SOURCE_DEFINITION",
              "PUBLISHED_ARTICLE_SUMMARY"
            ]
          },
          "sourceQuoteRefs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
