      "articles": [
        {
          "locale": "zh-Hans",
          "title": "扩展什么时候从可能变成行动",
          "summary": "扩展需要跨过阈值、受到触发，并把关键运行关系复制到新节点。机会本身不够；新位置必须能够重新承载运行。",
          "href": "/articles/book4-article-003",
          "articleCode": "BOOK4-B4-ART-003-ZH-HANS-ARTICLE"
        },
        {
          "locale": "en",
          "title": "When Expansion Moves From Possibility to Action",
          "summary": "Expansion requires a threshold, a trigger, and the ability to reproduce critical runtime relations in new nodes. Opportunity alone is not enough; a new location must be able to carry the runtime again.",
          "href": "/articles/book4-article-003",
          "articleCode": "BOOK4-B4-ART-003-EN-ARTICLE"
