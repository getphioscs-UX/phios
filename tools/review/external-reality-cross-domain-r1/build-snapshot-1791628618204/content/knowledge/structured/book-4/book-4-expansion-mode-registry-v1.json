      "articles": [
        {
          "locale": "zh-Hans",
          "title": "复制之后，运行为什么还需要传播与放大",
          "summary": "复制让运行能在新节点重建，传播让它跨越边界，放大则来自节点之间形成分工、网络效应、反馈与可重复调用。规模因此既会放大能力，也会放大错误与路径依赖。",
          "href": "/articles/book4-article-012",
          "articleCode": "BOOK4-B4-ART-012-ZH-HANS-ARTICLE"
        },
        {
          "locale": "en",
          "title": "Why Replication Still Needs Propagation and Amplification",
          "summary": "Replication allows a runtime to re-form at new nodes, propagation carries it across boundaries, and amplification emerges when nodes develop division of labor, network effects, feedback, and reusable structures. Scale therefore amplifies both capability and error.",
          "href": "/articles/book4-article-012",
          "articleCode": "BOOK4-B4-ART-012-EN-ARTICLE"
        }
      ],
