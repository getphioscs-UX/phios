{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kpp-cross-node-asset-assembly-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assemblyCode",
    "primaryNode",
    "supportingNodes",
    "knowledgeBoundaries",
    "sourceFragmentDigests",
    "targetAssetType",
    "locale",
    "status"
  ],
  "properties": {
    "assemblyCode": {
      "type": "string",
      "pattern": "^KPP-ASSEMBLY-"
    },
    "primaryNode": {
      "type": "string",
      "pattern": "^KN-"
    },
    "supportingNodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^KN-"
      },
      "uniqueItems": true
    },
    "knowledgeBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceFragmentDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "targetAssetType": {
      "enum": [
        "FIGURE",
        "DIAGRAM",
        "ACADEMY_LESSON",
        "SLIDES",
        "VIDEO_SCRIPT",
        "WEBSITE_MODULE"
      ]
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "enum": [
        "planned",
        "eligible",
        "deferred",
        "blocked"
      ]
    }
  }
}
