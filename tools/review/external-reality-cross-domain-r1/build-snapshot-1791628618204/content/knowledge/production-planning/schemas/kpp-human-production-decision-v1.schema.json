    "productionDecisionVersion": {
      "type": "string"
    },
    "nodeCode": {
      "type": "string"
    },
    "knowledgeVersion": {
      "type": "string"
    },
    "productionRole": {
      "type": "string"
    },
    "priority": {
      "type": "string"
