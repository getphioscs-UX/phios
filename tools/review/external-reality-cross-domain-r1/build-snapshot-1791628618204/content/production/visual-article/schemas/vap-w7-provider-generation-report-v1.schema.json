{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PHI-OS-VAP-W7-PROVIDER-GENERATION-REPORT-v1",
  "title": "VAP-W7 Provider Generation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "work",
    "batchCode",
    "nodeCode",
    "locale",
    "providerCode",
    "model",
    "operation",
    "briefPath",
    "briefDigest",
    "promptDigest",
    "providerResponseId",
    "candidatePath",
    "candidateDigest",
    "candidateAuthority",
    "humanReviewRequired",
    "publicationAllowed",
    "credentialPersisted"
  ],
  "properties": {
    "schemaVersion": { "const": "PHI-OS-VAP-W7-PROVIDER-GENERATION-REPORT-v1.0.0" },
    "work": { "const": "VAP-W7" },
    "batchCode": { "type": "string", "minLength": 1 },
    "nodeCode": { "type": "string", "pattern": "^KN-[A-Z0-9-]+$" },
    "locale": { "type": "string", "minLength": 2 },
    "providerCode": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "operation": { "const": "generate_article_candidate_from_governed_brief" },
    "briefPath": { "type": "string", "minLength": 1 },
    "briefDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "promptDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "providerResponseId": { "type": ["string", "null"] },
    "candidatePath": { "type": "string", "minLength": 1 },
    "candidateDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "candidateAuthority": { "const": false },
    "humanReviewRequired": { "const": true },
    "publicationAllowed": { "const": false },
    "credentialPersisted": { "const": false },
    "usage": { "type": ["object", "null"] },
    "generatedAt": { "type": "string", "minLength": 1 }
  }
}
