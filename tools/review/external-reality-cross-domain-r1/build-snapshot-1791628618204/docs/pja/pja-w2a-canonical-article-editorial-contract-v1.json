  "editorialContract": {
    "requiredFields": [
      "Article Identity",
      "Canonical Question",
      "Public Question",
      "Public Title",
      "Search Title",
      "Central Thesis",
      "Reader Transformation",
      "Required Mechanisms",
      "Required Distinctions",
      "Prohibited Claims",
      "Article Boundary",
      "Next Node Requirement",
      "Source Requirement",
      "Visual Requirement",
      "Review Requirement",
      "Publication Requirement"
    ],
    "definitions": {
      "Article Identity": {
        "purpose": "Binds the article to one frozen Canonical Node and its registered slug.",
        "authority": "content/knowledge/registry/nodes.json",
        "requiredValues": [
          "nodeCode",
          "canonicalQuestionKey",
          "canonicalLanguage",
          "slug"
        ]
      },
      "Canonical Question": {
        "purpose": "States the frozen question that defines the Node's knowledge identity.",
        "authority": "Canonical Node Registry"
      },
      "Public Question": {
        "purpose": "Expresses the Canonical Question for public readers without changing its identity.",
        "authority": "reviewed canonical-language editorial record"
      },
      "Public Title": {
        "purpose": "Names the public article and must remain semantically aligned with the Canonical Question.",
        "authority": "reviewed canonical-language editorial record"
      },
      "Search Title": {
        "purpose": "Provides a discoverable title without creating a second question or overstating the thesis.",
        "authority": "reviewed canonical-language editorial record"
      },
      "Central Thesis": {
        "purpose": "Freezes the single proposition the article will establish.",
        "authority": "canonical editorial review"
      },
      "Reader Transformation": {
        "purpose": "Defines the understanding readers should gain, not a personal outcome or recommendation.",
        "authority": "canonical editorial review"
      },
      "Required Mechanisms": {
        "purpose": "Lists causal or structural mechanisms the article must explain.",
        "authority": "canonical editorial review"
      },
      "Required Distinctions": {
        "purpose": "Lists concepts that must remain explicitly separate.",
        "authority": "canonical editorial review"
      },
      "Prohibited Claims": {
        "purpose": "Prevents unsupported, deterministic, anthropomorphic, universal, professional or personal claims.",
        "authority": "claim and boundary review"
      },
      "Article Boundary": {
        "purpose": "Defines what the public article does not determine, diagnose, recommend or replace.",
        "authority": "boundary review"
      },
      "Next Node Requirement": {
        "purpose": "Maintains registered knowledge continuity without linking to an unpublished Node.",
        "authority": "Canonical Node Registry relationships plus published-only projection"
      },
      "Source Requirement": {
        "purpose": "Defines evidence needed for each claim and prevents invented source codes.",
        "authority": "source and claim review"
      },
      "Visual Requirement": {
        "purpose": "Defines whether a governed visual materially improves understanding and how it enters through Asset Registry.",
        "authority": "visual review and Asset Registry"
      },
      "Review Requirement": {
        "purpose": "Lists all review domains required before publication state may advance.",
        "authority": "human editorial governance"
      },
      "Publication Requirement": {
        "purpose": "Preserves the PJA-W1 published-only Gate.",
        "requiredState": {
          "contentStatus": "content_reviewed",
          "reviewStatus": "approved",
          "publicationStatus": "published"
        }
      }
    },
    "frozenRules": {
      "canonicalNodeDeterminesArticleIdentity": true,
      "chineseArticleJsonIsCanonicalContent": true,
      "englishOnlyFromReviewedChineseVersion": true,
      "aiHasPublicationAuthority": false,
      "contentCompletionEqualsReviewCompletion": false,
      "registryPresenceEqualsProductionRequirement": false,
      "blueprintPresenceCreatesCanonicalIdentity": false
    }
  },
  "structuredArticleBlockModel": {
    "location": "sections[].blocks[]",
    "optional": true,
    "legacyLocation": "sections[].paragraphs[]",
    "legacyMigrationRequired": false,
    "schema": "content/knowledge/editorial/schemas/canonical-article.schema.json",
