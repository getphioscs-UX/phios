{
  "contractId": "phi-os.pws.canonical-events.v1",
  "schemaVersion": "pws-v1",
  "status": "frozen",
  "baseline": {
    "repository": "getphioscs-UX/phios",
    "branch": "main",
    "commit": "1a032cdf851d71060ddb2d0033b9d65b75e35254"
  },
  "operationContractId": "phi-os.pws.canonical-operations.v1",
  "rules": {
    "freeStringEventsAllowed": false,
    "eventIsPastFact": true,
    "eventMayExecuteOperation": false,
    "eventMayChangeState": false,
    "eventMayContainBusinessPayload": false,
    "eventMayContainSensitiveData": false,
    "eventIdRequired": true,
    "occurredAtRequired": true,
    "actorReferenceRequired": true,
    "subjectReferenceRequired": true,
    "causationReferenceRequired": true,
    "correlationIdRequired": true,
    "stateSnapshotRequiredWhenStateChanged": true,
    "appendOnly": true,
    "immutable": true,
    "providerOutputIsEventAllowed": false,
    "uiTelemetryIsCanonicalEventAllowed": false,
    "legacyEventWritesAllowed": false
  },
  "eventEnvelope": {
    "requiredFields": [
      "event_id",
      "event_code",
      "schema_version",
      "occurred_at",
      "actor_ref",
      "subject_ref",
      "causation_ref",
      "correlation_id"
    ],
    "conditionalFields": {
      "stateChanged": ["previous_state","resulting_state"],
      "providerInvocation": ["provider_usage_ref"],
      "providerBudget": ["provider_budget_ref"]
    },
    "forbiddenFields": [
      "payload",
      "content",
      "customer_data",
      "provider_output",
      "card_data",
      "document_body",
      "prompt",
      "completion"
    ]
  },
  "events": [
    {"eventId":"pws.event.payment.confirmed","eventCode":"payment.confirmed","subject":"Payment","causedBy":["payment.confirm"],"stateChanged":true},
    {"eventId":"pws.event.payment.failed","eventCode":"payment.failed","subject":"Payment","causedBy":["payment.fail"],"stateChanged":true},
    {"eventId":"pws.event.payment.refunded","eventCode":"payment.refunded","subject":"Payment","causedBy":["payment.refund"],"stateChanged":true},
    {"eventId":"pws.event.entitlement.activated","eventCode":"entitlement.activated","subject":"Entitlement","causedBy":["entitlement.activate"],"stateChanged":true},
    {"eventId":"pws.event.entitlement.revoked","eventCode":"entitlement.revoked","subject":"Entitlement","causedBy":["entitlement.revoke"],"stateChanged":true},
    {"eventId":"pws.event.consent.confirmed","eventCode":"consent.confirmed","subject":"Consent","causedBy":["consent.confirm"],"stateChanged":true},
    {"eventId":"pws.event.consent.withdrawn","eventCode":"consent.withdrawn","subject":"Consent","causedBy":["consent.withdraw"],"stateChanged":true},
    {"eventId":"pws.event.journey.activated","eventCode":"journey.activated","subject":"Journey","causedBy":["journey.activate"],"stateChanged":true},
    {"eventId":"pws.event.journey.paused","eventCode":"journey.paused","subject":"Journey","causedBy":["journey.pause"],"stateChanged":true},
    {"eventId":"pws.event.journey.resumed","eventCode":"journey.resumed","subject":"Journey","causedBy":["journey.resume"],"stateChanged":true},
    {"eventId":"pws.event.assignment.created","eventCode":"assignment.created","subject":"Assignment","causedBy":["assignment.create"],"stateChanged":true},
    {"eventId":"pws.event.assignment.accepted","eventCode":"assignment.accepted","subject":"Assignment","causedBy":["assignment.accept"],"stateChanged":true},
    {"eventId":"pws.event.assignment.completed","eventCode":"assignment.completed","subject":"Assignment","causedBy":["assignment.complete"],"stateChanged":true},
    {"eventId":"pws.event.readiness.passed","eventCode":"readiness.passed","subject":"Professional Readiness","causedBy":["readiness.evaluate"],"outcome":"ready","stateChanged":true},
    {"eventId":"pws.event.readiness.blocked","eventCode":"readiness.blocked","subject":"Professional Readiness","causedBy":["readiness.evaluate"],"outcome":"blocked","stateChanged":true},
    {"eventId":"pws.event.professionalResponse.recorded","eventCode":"professionalResponse.recorded","subject":"Professional Response","causedBy":["professionalResponse.confirm","professionalResponse.refine","professionalResponse.challenge","professionalResponse.extend"],"stateChanged":true},
    {"eventId":"pws.event.deliverable.frozen","eventCode":"deliverable.frozen","subject":"Deliverable","causedBy":["deliverable.freeze"],"stateChanged":true},
    {"eventId":"pws.event.deliverable.signed","eventCode":"deliverable.signed","subject":"Deliverable","causedBy":["deliverable.sign"],"stateChanged":true},
    {"eventId":"pws.event.deliverable.released","eventCode":"deliverable.released","subject":"Deliverable","causedBy":["deliverable.release"],"stateChanged":true},
    {"eventId":"pws.event.provider.invocation.started","eventCode":"provider.invocation.started","subject":"Provider Usage","causedBy":["provider_boundary.start"],"stateChanged":false},
    {"eventId":"pws.event.provider.invocation.failed","eventCode":"provider.invocation.failed","subject":"Provider Usage","causedBy":["provider_boundary.fail"],"stateChanged":false},
    {"eventId":"pws.event.provider.invocation.completed","eventCode":"provider.invocation.completed","subject":"Provider Usage","causedBy":["provider_boundary.complete"],"stateChanged":false},
    {"eventId":"pws.event.provider.budget.warning","eventCode":"provider.budget.warning","subject":"Provider Budget","causedBy":["provider_budget_threshold.warning"],"stateChanged":false},
    {"eventId":"pws.event.provider.budget.blocked","eventCode":"provider.budget.blocked","subject":"Provider Budget","causedBy":["provider_budget_threshold.blocked"],"stateChanged":false}
  ],
  "deprecatedLegacyEvents": [
    {"eventCode":"assignment.cancelled","replacement":null,"handling":"legacy_read_only; cancellation remains an Operation result but is outside Canonical Events v1"},
    {"eventCode":"readiness.evaluation_started","replacement":["readiness.passed","readiness.blocked"],"handling":"legacy_read_only; outcome must be explicit"},
    {"eventCode":"professionalResponse.confirmed","replacement":["professionalResponse.recorded"],"handling":"legacy_read_only; preserve response kind separately"},
    {"eventCode":"professionalResponse.refined","replacement":["professionalResponse.recorded"],"handling":"legacy_read_only; preserve response kind separately"},
    {"eventCode":"professionalResponse.challenged","replacement":["professionalResponse.recorded"],"handling":"legacy_read_only; preserve response kind separately"},
    {"eventCode":"professionalResponse.extended","replacement":["professionalResponse.recorded"],"handling":"legacy_read_only; preserve response kind separately"},
    {"eventCode":"capability.activated","replacement":null,"handling":"legacy_read_only"},
    {"eventCode":"capability.suspended","replacement":null,"handling":"legacy_read_only"},
    {"eventCode":"professional.verified","replacement":null,"handling":"legacy_read_only"}
  ],
  "existingEventBoundaries": [
    {"scope":"Customer Runtime timeline","paths":["functions/runtime/timeline/event-types.js","functions/runtime/timeline/event-append-service.js"],"handling":"preserve Runtime ownership; do not rename or replace"},
    {"scope":"Professional access audit","paths":["functions/professional/access/professional-access-audit.js"],"handling":"preserve payload-free access audit; not a Canonical Event"},
    {"scope":"Provider execution","paths":["functions/runtime/shared/provider-interface.js","functions/runtime/entry/providers","functions/runtime/reading/providers"],"handling":"record invocation metadata only; Provider output never becomes an Event or formal object"},
    {"scope":"Gateway webhook inputs","paths":["functions/api","functions/_lib","functions/commerce"],"handling":"verify external input before an authorised Operation emits an Event"}
  ]
}
