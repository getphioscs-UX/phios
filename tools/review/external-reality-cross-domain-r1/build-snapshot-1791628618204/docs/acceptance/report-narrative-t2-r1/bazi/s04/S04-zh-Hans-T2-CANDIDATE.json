        "S04_CAREER:PAIR_BAZI-CX-PRO-W5-REL-03",
        "S04_CAREER:PAIR_BAZI-CX-PRO-W5-REL-04"
      ],
      "supportRefs": [
        "professionalModules/customerNarrative/topicNarratives/0/development",
