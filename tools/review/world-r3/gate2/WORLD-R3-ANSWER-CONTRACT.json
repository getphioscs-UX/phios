{
  "contract": "WORLD_R3_ANSWER_DESIGN_DRAFT",
  "authority": "GATE2_ARTIFACT_ONLY_NOT_CANONICAL_ADMISSION",
  "implementation": "Three manually authored, source-bounded prototype examples; no generative service",
  "fields": {
    "question": [
      "originalQuestion",
      "locale",
      "explicitRegion",
      "explicitYear",
      "readingScale"
    ],
    "directAnswer": [
      "bounded text",
      "answerType",
      "retrievalStatus",
      "what this does not establish"
    ],
    "facts": [
      "claim class",
      "source ID",
      "definition",
      "geography/period if observed",
      "unit/denominator if numeric",
      "source revision",
      "retrieval date",
      "missing-state"
    ],
    "interpretation": [
      "manuscript source IDs and locale/version/hash",
      "conditional mechanism, not measured causality"
    ],
    "visual": [
      "source geometry or clearly labeled interpretive sketch",
      "purpose",
      "what the visual cannot prove"
    ],
    "impacts": [
      "conditional relevance only",
      "no inferred individual facts"
    ],
    "limits": [
      "unknowns",
      "competing interpretations",
      "forbidden inference"
    ],
    "next": [
      "question-specific reading reason",
      "comparison or follow-up",
      "actual source route"
    ]
  },
  "conditionals": [
    "omit unsupported numeric charts",
    "render data requirements as a labeled checklist, not measured values",
    "show private input only after opt-in",
    "show source reading only when relevant, with an explicit reason"
  ],
  "prototypeRetrievalStatuses": [
    "DEFINITION_SUPPORTED_ANNUAL_VALUES_MISSING",
    "INTERPRETIVE_SOURCE_ONLY",
    "UNMATCHED_QUESTION_NO_VERIFIED_ANSWER"
  ],
  "currentEvidence": {
    "officialDefinitions": 2,
    "existingPublishedReadings": 5,
    "regionalAnnualValuesLoaded": 0,
    "privateFactsLoaded": 0
  },
  "productionNeeds": [
    "typed claim IDs and retrieval transaction provenance",
    "definition/year/unit/price/frequency/population alignment for comparison",
    "permission checks before any model composition",
    "bounded state/context contract wired into existing owners"
  ],
  "gate3": "NOT_AUTHORIZED"
}
