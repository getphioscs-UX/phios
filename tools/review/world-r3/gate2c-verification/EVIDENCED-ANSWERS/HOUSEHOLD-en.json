  "answerability": "MECHANISM_ANSWERABLE",
  "direct_answer": {
    "text": "A lower rate reduces the interest component for a given loan, but the home price, down payment, loan size, term, fees and household income still matter. A larger required deposit or loan can leave housing unaffordable. This is a conditional mechanism, not proof of a current local trend.",
    "kind": "conditional_mechanism"
  },
