  "answerability": "FACT_ANSWERABLE",
  "direct_answer": {
    "text": "No. In the October 2024 survey, government home-purchase mortgage respondents reported a net 2.04% tightening standards and net −10.20% stronger demand, from 49 banks. These different survey measures illustrate weaker demand with broadly unchanged standards; neither is a national denial rate.",
    "kind": "observed_fact"
  },
