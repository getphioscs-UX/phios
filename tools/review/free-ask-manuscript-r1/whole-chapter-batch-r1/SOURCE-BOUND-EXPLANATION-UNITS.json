    {
      "unitId": "MAINTENANCE_V_REPAIR",
      "conceptIds": [
        "SOURCE-RUN-MAINTENANCE"
      ],
      "locale": "zh-Hans",
      "sourceSectionId": "CM-B3V1-P8-S001",
      "support": {
        "startOffset": 915,
        "endOffset": 999,
        "textSha256": "5bd6e6732ecfa1d37a6c8510d066922343496225e6e6a97b86afe7824380c3d9"
      },
      "mainArgument": "维护首先不是修理，而是\n处理持续所产生的后果。修理通常发生在某个结构已经明显损坏之后，维\n护则更早，它关注的是一个仍然能够运行的现实，是否正在逐渐改变自己\n的承载条件。",
      "definition": null,
      "conditions": null,
      "boundary": null,
      "applicableComparison": "维护首先不是修理，而是\n处理持续所产生的后果。修理通常发生在某个结构已经明显损坏之后，维\n护则更早，它关注的是一个仍然能够运行的现实，是否正在逐渐改变自己\n的承载条件。",
      "mechanism": null,
      "additionalConclusionsAllowed": false,
      "fullChapterCoverage": false,
      "unit": {
