    {
      "unitId": "UPDATING_NOT_FREEZING",
      "conceptIds": [
        "SOURCE-STRUCTURAL-CONTINUITY"
      ],
      "locale": "zh-Hans",
      "sourceSectionId": "B1V3-P1-S006",
      "support": {
