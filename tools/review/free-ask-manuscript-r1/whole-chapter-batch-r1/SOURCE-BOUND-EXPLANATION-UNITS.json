    {
      "unitId": "STATE_COLLAPSE_NOT_CIVILIZATION_ZERO",
      "conceptIds": [
        "SOURCE-CIVILIZATION-STATE-BOUNDARIES",
        "SOURCE-POLITICAL-CIVILIZATION-CONTINUITY",
        "SOURCE-STATE-INTERNAL-DIVERSITY"
