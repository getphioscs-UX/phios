        "textSha256": "9ccbff199107c83d19ea78d409d814e1a4b9722d62c860fc43c5fe6ba3c0712a"
      },
      "mainArgument": "持续因此不是停止更新，而是持续更新之后，系统仍然能够保持\n自身。",
      "definition": null,
      "conditions": null,
      "boundary": null,
      "applicableComparison": "持续因此不是停止更新，而是持续更新之后，系统仍然能够保持\n自身。",
      "mechanism": null,
      "additionalConclusionsAllowed": false,
      "fullChapterCoverage": false,
