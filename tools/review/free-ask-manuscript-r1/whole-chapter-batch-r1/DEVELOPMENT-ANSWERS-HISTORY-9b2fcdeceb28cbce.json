    {
      "id": "III-MAINTENANCE-PRO",
      "book": "BOOK-3",
      "section": "CM-B3V1-P8-S001",
      "argument": "PROFESSIONAL_LIMIT",
      "q": "维护是否可以只靠运行语言解释所有身体或心理变化？",
