      "pack": {
        "question": "观察不到一个对象时，可以据此断定它不存在吗？",
        "locale": "zh-Hans",
        "sources": [
          {
            "id": "S1",
            "sourceCode": "MKS-BOOK-7-V2-ACCEPTED-KNOWLEDGE-UNITS-ZH",
            "sourceVersion": "v2-accepted-knowledge-projection",
            "sourceSha256": "e19b662d8928df7608f4f1814f14f83d0397e3822d4d289f5ab2fd41f9b60c1d",
            "sourceAcceptanceDigest": "fcf3fcd3ef7d7115c105799a0bb5a75f561d774a7043acfe3228840d31e2de3b",
            "chapterId": "14.86",
            "heading": "未观察不等于不存在",
            "sourceLanguage": "zh-Hans",
            "pdfPages": {
              "start": 324,
              "end": 324
            },
            "support": {
              "startOffset": 0,
              "endOffset": 59,
              "textSha256": "c87ef5cd20ef78c46c516a331dfbe7d6fe70e14114c869909668ec1b33d1b89d"
            },
            "text": "没有观察到只说明当前证据没有可靠分辨目标；低解析度、观察范围或时间窗口可能留下未知。未观察不等于不存在，未知不等于零。",
            "readingHref": null,
            "chapterDeepLink": "/membership-source.html?bookCode=BOOK-7&chapter=14.86&q=%E8%A7%82%E5%AF%9F%E4%B8%8D%E5%88%B0%E4%B8%80%E4%B8%AA%E5%AF%B9%E8%B1%A1%E6%97%B6%EF%BC%8C%E5%8F%AF%E4%BB%A5%E6%8D%AE%E6%AD%A4%E6%96%AD%E5%AE%9A%E5%AE%83%E4%B8%8D%E5%AD%98%E5%9C%A8%E5%90%97%EF%BC%9F&locale=zh-Hans",
            "chapterDeepLinkState": "SERVER_PERMISSION_CHECKED_CHAPTER_DESCRIPTION",
            "purchaseHref": null,
            "purchaseLinkRole": "BOOK_PRODUCT_INFORMATION_NOT_FULL_TEXT_ACCESS",
            "permissions": {
              "knowledgeExcerpt": true,
