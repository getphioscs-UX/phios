          "logprobs": [],
          "text": "{\n  \"locale\": \"en\",\n  \"claims\": [\n    {\n      \"text\": \"An organization can endure because its continuity depends not on preserving every individual component, but on continually reorganizing those components and maintaining its way of operating.\",\n      \"supportFragmentIds\": [\n        \"F-1d3a288563890410a103383b6f1c33d31e56465a2ce7390c59105b4bee413edc\"\n      ]\n    },\n    {\n      \"text\": \"This endurance is a dynamic capacity: the organization must continually restore itself, respond to disturbances, adjust remaining structures when some change, establish new paths when old ones fail, and adapt its organization as conditions change.\",\n      \"supportFragmentIds\": [\n        \"F-1d3a288563890410a103383b6f1c33d31e56465a2ce7390c59105b4bee413edc\"\n      ]\n    },\n    {\n      \"text\": \"Thus, stability is not the absence of change; it is the continued coordination of change so that overall operation is preserved. The fragment illustrates this with a city whose buildings, roads, facilities, population, and industries change while transportation, resources, production, communication, and order continue.\",\n      \"supportFragmentIds\": [\n        \"F-1d3a288563890410a103383b6f1c33d31e56465a2ce7390c59105b4bee413edc\"\n      ]\n    }\n  ],\n  \"sourceLanguages\": [\n    \"zh-Hans\"\n  ],\n  \"status\": \"answered\",\n  \"boundary\": \"The fragment supports this account of continuity through reorganization, recovery, adaptation, and coordination. It does not specify how much replacement an organization can withstand, the exact conditions required for recovery, or whether every kind of organization behaves this way.\"\n}"
        }
      ],
