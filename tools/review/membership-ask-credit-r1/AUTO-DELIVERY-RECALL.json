              "end": 324
            },
            "support": {
              "startOffset": 0,
              "endOffset": 59,
              "textSha256": "c87ef5cd20ef78c46c516a331dfbe7d6fe70e14114c869909668ec1b33d1b89d"
            },
            "text": "没有观察到只说明当前证据没有可靠分辨目标；低解析度、观察范围或时间窗口可能留下未知。未观察不等于不存在，未知不等于零。",
            "readingHref": null,
            "chapterDeepLink": "/membership-source.html?bookCode=BOOK-7&chapter=14.86&q=%E6%B2%A1%E6%9C%89%E8%A7%82%E5%AF%9F%E5%88%B0%E6%9F%90%E4%B8%AA%E4%BA%8B%E7%89%A9%EF%BC%8C%E6%98%AF%E5%90%A6%E8%B6%B3%E4%BB%A5%E8%AE%A4%E5%AE%9A%E5%85%B6%E4%B8%8D%E5%AD%98%E5%9C%A8%EF%BC%9F&locale=zh-Hans",
