{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/vap-w22-cpr-production-instance-v1.schema.json",
  "title": "PHI OS CPR Production Instance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "presentationCode",
    "presentationIdentity",
    "presentationVersion",
    "work",
    "phase",
    "status",
    "surface",
    "presentationType",
    "renderState",
    "locale",
    "audience",
    "authorityBoundaries",
    "inputs",
    "informationDensity",
    "composition",
    "figurePresentation",
    "pdsReferences",
    "responsiveProjection",
    "localeAcceptance"
  ],
  "properties": {
    "schemaVersion": { "const": "PHI-OS-CPR-PRODUCTION-INSTANCE-v1.0.0" },
    "presentationCode": {
      "type": "string",
      "pattern": "^PRESENTATION-[A-Z0-9-]+-(EN|ZH-HANS)-v[1-9][0-9]*$"
    },
    "presentationIdentity": {
      "type": "string",
      "pattern": "^PRESENTATION-[A-Z0-9-]+$"
    },
    "presentationVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "work": { "const": "VAP-W22" },
    "phase": { "const": "VAP-E_CPR_PDS_PRODUCTION_PRESENTATION" },
    "status": { "const": "active_production_instance" },
    "surface": { "const": "WEBSITE" },
    "presentationType": { "const": "ARTICLE_PAGE" },
    "renderState": { "const": "ready_for_render" },
    "locale": { "enum": ["en", "zh-Hans"] },
    "audience": { "enum": ["CUSTOMER", "PROFESSIONAL", "TECHNICAL"] },
    "authorityBoundaries": {
      "type": "object",
      "required": ["decides", "doesNotDecide"],
      "properties": {
        "decides": {
          "const": ["COMPOSITION", "PLACEMENT", "INFORMATION_DENSITY", "SURFACE", "RESPONSIVE_PROJECTION"]
        },
        "doesNotDecide": { "const": ["KNOWLEDGE", "MEANING", "ASSET_APPROVAL"] }
      }
    },
    "inputs": { "type": "object" },
    "informationDensity": { "type": "object" },
    "composition": { "type": "array", "minItems": 1 },
    "figurePresentation": { "type": "object" },
    "pdsReferences": { "type": "object" },
    "responsiveProjection": { "type": "array", "minItems": 3, "maxItems": 3 },
    "localeAcceptance": { "type": "array", "minItems": 2, "maxItems": 2 }
  }
}
