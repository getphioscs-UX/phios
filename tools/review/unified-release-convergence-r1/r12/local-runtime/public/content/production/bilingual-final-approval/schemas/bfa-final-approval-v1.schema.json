{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"PHI-OS-BFA-FINAL-APPROVAL-v1",
  "type":"object",
  "required":["authorityType","batchCode","nodeCode","finalPackageDigest","decision","reviewerCode","decidedAt","summary","authorityDigest"],
  "properties":{
    "authorityType":{"const":"BILINGUAL_FINAL_PUBLICATION_APPROVAL"},
    "batchCode":{"pattern":"^BATCH-[0-9]{3,}$"},
    "nodeCode":{"pattern":"^KN-[A-Z0-9-]+$"},
    "finalPackageDigest":{"pattern":"^[a-f0-9]{64}$"},
    "decision":{"enum":["approve_for_publication","revise","defer","do_not_publish"]},
    "reviewerCode":{"const":"TL"},
    "decidedAt":{"type":"string","minLength":1},
    "summary":{"type":"string","minLength":1},
    "warningAcknowledgements":{"type":"array"},
    "authorityDigest":{"pattern":"^[a-f0-9]{64}$"}
  },
  "additionalProperties":true
}
