  "articleBoundary": {
    "mustEstablish": [
      {
        "label": null,
        "requirement": "导航同时依赖当前位置、变化方向与共同坐标参照。"
      },
      {
        "label": null,
        "requirement": "坐标不是附加标签，而是让位置与方向可以重复比较的关系结构。"
      },
      {
        "label": null,
        "requirement": "导航是持续比较与修正，而不是一次性的目标选择。"
      }
