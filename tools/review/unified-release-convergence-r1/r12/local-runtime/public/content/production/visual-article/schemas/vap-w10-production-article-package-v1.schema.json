  "required": ["schemaVersion", "packageType", "packageCode", "work", "batchCode", "nodeCode", "locale", "packageState", "articlePackageContract", "binding", "article", "candidate", "review", "approval", "authority", "governance", "createdAt", "nextAuthority", "packageDigest"],
