    "packageType": {"const": "approved_article_production_handoff"},
    "packageCode": {"type": "string"}, "work": {"const": "VAP-W10"}, "batchCode": {"const": "VAP-ARTICLE-BATCH-001"}, "nodeCode": {"type": "string"}, "locale": {"const": "zh-Hans"},
    "packageState": {"const": "human_approved_not_published"}, "articlePackageContract": {"const": "PHI-OS-PJA-R4E-ARTICLE-PACKAGE-v2.0.0"},
