{
  "schemaVersion": "PHI-OS-PERSONAL-STRUCTURE-TYPE-RESOLUTION-v1.0.0",
  "work": "MIR-3",
  "status": "ACTIVE",
  "order": [
    {
      "when": "definedCenterCount == 0",
      "result": "REFLECTOR"
    },
    {
      "when": "SACRAL defined AND any defined Motor has graph path to THROAT",
      "result": "MANIFESTING_GENERATOR"
    },
    {
      "when": "SACRAL defined",
      "result": "GENERATOR"
    },
    {
      "when": "SACRAL undefined AND any defined Motor has graph path to THROAT",
      "result": "MANIFESTOR"
    },
    {
      "when": "otherwise",
      "result": "PROJECTOR"
    }
  ],
  "motorSet": [
    "SACRAL",
    "SOLAR_PLEXUS",
    "EGO",
    "ROOT"
  ],
  "directChannelOnly": false
}
