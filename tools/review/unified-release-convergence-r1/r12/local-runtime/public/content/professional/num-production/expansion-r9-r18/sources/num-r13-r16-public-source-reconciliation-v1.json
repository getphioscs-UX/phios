  "formulaAuthority": {
    "R13_LIFE_PERIOD": {
      "status": "GRANTED_CALCULATION_ONLY",
      "formula": {
        "base": "DDMMYYYY -> A..H; reduce pair sums A+B=I, C+D=J, E+F=K, G+H=L; I+J=M; K+L=N; M+N=O",
        "left": "J+M=W; I+M=X; X+W=S; period code uses XWS",
        "top": "N+O=Q; M+O=P; Q+P=R; period code uses QPR",
        "right": "K+N=V; L+N=U; V+U=T; period code uses VUT",
        "bands": ["21-40:XWS", "41-60:QPR", "61-80:VUT"]
      },
      "boundaryNote": "Public corroboration commonly describes the final band as 61+ or after 60; the user learning corpus explicitly records 61-80. PHI OS preserves 61-80 for this reconstructed school and leaves post-80 undefined."
    },
    "R15_ALTERNATIVE_TIMING": {
      "status": "GRANTED_CALCULATION_ONLY",
      "flowYearFormula": "Keep birth day and month; replace birth year with target calendar year; rebuild hologram; MNO is flow-year code and O is its single-digit number.",
      "phaseFormula": {
        "FEB_MAY": "natal QPR",
        "JUN_SEP": "natal VUT",
        "OCT_JAN": "natal physical-left display WXS; canonical left combo remains XWS"
      },
      "phaseWindows": ["02-01..05-31", "06-01..09-30", "10-01..01-31"],
      "boundaryNote": "The 4-month phase windows and display order are grounded in the user learning corpus; public sources corroborate the hologram and flow-year year-substitution method, not the exact phase-window semantics."
    },
