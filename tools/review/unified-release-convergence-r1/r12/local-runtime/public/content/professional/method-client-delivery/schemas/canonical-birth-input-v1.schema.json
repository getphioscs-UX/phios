{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/mcd/canonical-birth-input-v1.schema.json",
  "title": "PHI OS MCD-3 CanonicalBirthInput v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "birthDate",
    "birthTime",
    "birthPlace",
    "timezone",
    "timeAccuracy",
    "locale",
    "consent",
    "inputVersion"
  ],
  "properties": {
    "birthDate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "birthTime": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "birthPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "countryCode",
        "latitude",
        "longitude"
      ],
      "properties": {
        "displayName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "countryCode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "timezone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iana",
        "utcOffsetAtBirth",
        "source",
        "confidence"
      ],
      "properties": {
        "iana": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z_+\\-]+(?:/[A-Za-z0-9_+\\-]+)+$"
        },
        "utcOffsetAtBirth": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[+-](?:0[0-9]|1[0-4]):[0-5][0-9]$"
        },
        "source": {
          "enum": [
            "PINNED_IANA_TZDB",
            "GOVERNED_RESOLUTION",
            "HUMAN_DECLARATION",
            "UNKNOWN"
          ]
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        }
      }
    },
    "timeAccuracy": {
      "enum": [
        "EXACT",
        "APPROXIMATE",
        "UNKNOWN"
      ]
    },
    "locale": {
      "enum": [
        "en",
        "zh-Hans"
      ]
    },
    "consent": {
      "type": "object"
    },
    "inputVersion": {
      "const": "MCD-3-CANONICAL-BIRTH-INPUT-v1.0.0"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "timeAccuracy": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "timeAccuracy"
        ]
      },
      "then": {
        "properties": {
          "birthTime": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "timeAccuracy": {
            "enum": [
              "EXACT",
              "APPROXIMATE"
            ]
          }
        },
        "required": [
          "timeAccuracy"
        ]
      },
      "then": {
        "properties": {
          "birthTime": {
            "type": "string"
          }
        }
      }
    }
  ]
}
