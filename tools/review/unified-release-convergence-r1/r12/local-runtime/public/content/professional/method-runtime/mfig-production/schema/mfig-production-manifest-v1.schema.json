{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/mfig-production-manifest-v1.json",
  "title": "MFIG Production Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mfigId",
    "generatedAgainstCommit",
    "registryDigest",
