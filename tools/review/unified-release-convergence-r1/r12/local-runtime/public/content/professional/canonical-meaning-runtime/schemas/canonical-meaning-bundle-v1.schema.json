{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/canonical-meaning-bundle-v1.schema.json",
  "title": "PHI OS Canonical Meaning Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleCode",
    "bundleVersion",
    "projectionLineage",
    "meanings",
    "supportingSignals",
    "contradictingSignals",
    "unresolvedSignals",
    "sourceIndependence",
    "knowledgeCoverage",
    "limitations",
    "status"
  ],
  "properties": {
    "bundleCode": { "type": "string", "pattern": "^CMB-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "bundleVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "projectionLineage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "meanings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "canonical-meaning-v1.schema.json" }
    },
    "supportingSignals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "contradictingSignals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unresolvedSignals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sourceIndependence": { "type": "boolean" },
    "knowledgeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "nodeCount", "publishedFragmentCount", "locale"],
      "properties": {
        "status": { "type": "string", "enum": ["none", "partial", "sufficient"] },
        "nodeCount": { "type": "integer", "minimum": 0 },
        "publishedFragmentCount": { "type": "integer", "minimum": 0 },
        "locale": { "type": "string", "enum": ["zh-Hans", "en"] }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "status": { "type": "string", "enum": ["validation_only", "deprecated"] }
  }
}
