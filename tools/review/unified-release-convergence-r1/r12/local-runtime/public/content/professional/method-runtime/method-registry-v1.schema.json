{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/method-runtime/method-registry-v1.schema.json",
  "title": "PHI OS MR-W1 Method Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stageCode",
    "registryCode",
    "registryVersion",
    "status",
    "baseline",
    "contractSeed",
    "lifecycleContract",
    "pluginRegistryContract",
    "populationAuthority",
    "runtimeCode",
    "runtimeVersion",
    "requiredFields",
    "registrationPolicy",
    "methods"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-METHOD-REGISTRY-POPULATION-v1.0.0"
    },
    "stageCode": {
      "const": "MR-W1"
    },
    "registryCode": {
      "const": "METHOD_REGISTRY"
    },
    "registryVersion": {
      "const": "1.0.0"
    },
    "status": {
      "const": "frozen"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "getphioscs-UX/phios"
        },
        "branch": {
          "const": "main"
        },
        "commit": {
          "const": "a8e8c642af0052c3579e75ce9c9a0fd124002241"
        }
      }
    },
    "contractSeed": {
      "const": "content/professional/method-runtime/method-registry.json"
    },
    "lifecycleContract": {
      "const": "content/professional/method-runtime/method-runtime-lifecycle.json"
    },
    "pluginRegistryContract": {
      "const": "content/professional/method-runtime/method-plugin-registry.json"
    },
    "populationAuthority": {
      "const": "MR-W1"
    },
    "runtimeCode": {
      "const": "METHOD_RUNTIME"
    },
    "runtimeVersion": {
      "const": "1.0.0"
    },
    "requiredFields": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "prefixItems": [
        {
          "const": "methodCode"
        },
        {
          "const": "methodVersion"
        },
        {
          "const": "status"
        },
        {
          "const": "runtimeVersion"
        },
        {
          "const": "projectionVersion"
        },
        {
          "const": "requiresProfessional"
        },
        {
          "const": "licenseStatus"
        }
      ],
      "items": false
    },
    "registrationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodDefinitionBeforeRuntimeRequired",
        "pluginCodeReservationRequired",
        "methodRegistrationCreatesPluginExecution",
        "registrationCreatesProductionAuthority",
        "duplicateMethodCodeAllowed",
        "duplicatePluginCodeAllowed",
        "productionRequiresImr",
        "productionAllowedLicenseStatus",
        "futureRegistrationRequiresVersionedChange"
      ],
      "properties": {
        "methodDefinitionBeforeRuntimeRequired": {
          "const": true
        },
        "pluginCodeReservationRequired": {
          "const": true
        },
        "methodRegistrationCreatesPluginExecution": {
          "const": false
        },
        "registrationCreatesProductionAuthority": {
          "const": false
        },
        "duplicateMethodCodeAllowed": {
          "const": false
        },
        "duplicatePluginCodeAllowed": {
          "const": false
        },
        "productionRequiresImr": {
          "const": true
        },
        "productionAllowedLicenseStatus": {
          "const": [
            "approved",
            "not_required"
          ]
        },
        "futureRegistrationRequiresVersionedChange": {
          "const": true
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/method"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodCode",
        "methodName",
        "methodVersion",
        "status",
        "runtimeVersion",
        "projectionVersion",
        "requiresProfessional",
        "licenseStatus",
        "pluginCode",
        "category",
        "targetTrack",
        "definitionStatus",
        "imrStatus",
        "serviceStatus",
        "calculationStatus",
        "productionEligible",
        "methodRegistrationStatus",
        "pluginRegistrationStatus",
        "authoritySources"
      ],
      "properties": {
        "methodCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,31}$"
        },
        "methodName": {
          "type": "string",
          "minLength": 1
        },
        "methodVersion": {
          "$ref": "#/$defs/semver"
        },
        "status": {
          "enum": [
            "draft",
            "experimental",
            "internal",
            "pilot",
            "production",
            "deprecated",
            "archived"
          ]
        },
        "runtimeVersion": {
          "const": "1.0.0"
        },
        "projectionVersion": {
          "$ref": "#/$defs/semver"
        },
        "requiresProfessional": {
          "const": true
        },
        "licenseStatus": {
          "enum": [
            "approved",
            "not_required",
            "restricted",
            "prohibited",
            "expired"
          ]
        },
        "pluginCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]{2,31}$"
        },
        "category": {
          "enum": [
            "core",
            "planned"
          ]
        },
        "targetTrack": {
          "enum": [
            "HDR",
            "AST",
            "BZR",
            "ICH",
            "TAR",
            "PSY"
          ]
        },
        "definitionStatus": {
          "enum": [
            "defined",
            "draft"
          ]
        },
        "imrStatus": {
          "enum": [
            "not_assessed",
            "conditional_passed",
            "production_eligible"
          ]
        },
        "serviceStatus": {
          "enum": [
            "preserved",
            "inactive",
            "not_implemented"
          ]
        },
        "calculationStatus": {
          "enum": [
            "external_only_preserved",
            "pilot_candidate_validation_required",
            "policy_candidate_validation_required",
            "not_implemented"
          ]
        },
        "productionEligible": {
          "type": "boolean"
        },
        "methodRegistrationStatus": {
          "const": "registered"
        },
        "pluginRegistrationStatus": {
          "const": "pending_contract"
        },
        "authoritySources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "MR-W1",
              "IMR-W0",
              "HDR-W0"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "planned"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "draft"
              },
              "definitionStatus": {
                "const": "draft"
              },
              "imrStatus": {
                "const": "not_assessed"
              },
              "serviceStatus": {
                "const": "not_implemented"
              },
              "calculationStatus": {
                "const": "not_implemented"
              },
              "productionEligible": {
                "const": false
              },
              "licenseStatus": {
                "const": "restricted"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "production"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "imrStatus": {
                "const": "production_eligible"
              },
              "productionEligible": {
                "const": true
              },
              "licenseStatus": {
                "enum": [
                  "approved",
                  "not_required"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
