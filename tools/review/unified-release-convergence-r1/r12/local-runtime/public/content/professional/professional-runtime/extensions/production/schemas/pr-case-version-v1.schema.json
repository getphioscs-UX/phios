{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schema/pr-case-version-v1.schema.json",
  "title": "PHI OS PR Case Version v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objectClass",
    "caseReference",
    "caseVersion",
    "caseDigest",
    "previousCaseVersion",
    "previousCaseDigest",
    "assignmentReference",
    "workspaceReference",
    "customerReference",
    "professionalReference",
    "serviceReference",
    "scope",
    "consentReferences",
    "status",
    "openedAt",
    "closedAt",
    "versionDigest",
    "persistence"
  ],
  "properties": {
    "objectClass": {
      "const": "PR_CASE_VERSION"
    },
    "caseReference": {
      "type": "string",
      "minLength": 1
    },
    "caseVersion": {
      "type": "integer",
      "minimum": 1
    },
    "caseDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previousCaseVersion": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "previousCaseDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "assignmentReference": {
      "type": "string",
      "minLength": 1
    },
    "workspaceReference": {
      "type": "string",
      "minLength": 1
    },
    "customerReference": {
      "type": "string",
      "minLength": 1
    },
    "professionalReference": {
      "type": "string",
      "minLength": 1
    },
    "serviceReference": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "consentReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "CLOSED"
      ]
    },
    "openedAt": {
      "type": "string",
      "format": "date-time"
    },
    "closedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "versionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "intentReference",
        "storageWritePerformed",
        "executorAuthority",
        "executorState"
      ],
      "properties": {
        "state": {
          "const": "PERSISTENCE_INTENT_READY"
        },
        "intentReference": {
          "type": "string",
          "minLength": 1
        },
        "storageWritePerformed": {
          "const": false
        },
        "executorAuthority": {
          "const": "PWS_OR_STORAGE_EXECUTOR"
        },
        "executorState": {
          "const": "NOT_IMPLEMENTED_FAIL_CLOSED"
        }
      }
    }
  }
}
