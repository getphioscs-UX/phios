{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/asset-candidate-v1.schema.json",
  "title": "PHI OS Asset Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidateCode",
    "candidateVersion",
    "assetCode",
    "assetType",
    "nodeCode",
    "assetBriefCode",
    "assetBriefDigest",
    "meaningReferences",
    "knowledgeReferences",
    "sourceFragmentDigests",
    "locale",
    "candidatePayload",
    "providerLineage",
    "candidateState",
    "candidateDigest",
    "createdAt"
  ],
  "properties": {
    "candidateCode": {
      "type": "string",
      "pattern": "^CAR-CAND-[A-Z0-9-]+$"
    },
    "candidateVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "assetCode": {
      "type": "string",
      "pattern": "^ASSET-[A-Z0-9-]+$"
    },
    "assetType": {
      "type": "string",
      "minLength": 1
    },
    "nodeCode": {
      "type": "string",
      "pattern": "^KN-[A-Z0-9-]+$"
    },
    "assetBriefCode": {
      "type": "string",
      "minLength": 1
    },
    "assetBriefDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "meaningReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CM-[A-Z0-9-]+$"
      }
    },
    "knowledgeReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^KN-[A-Z0-9-]+$"
      }
    },
    "sourceFragmentDigests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "candidatePayload": {
      "type": "object"
    },
    "providerLineage": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "local_projection",
            "provider_candidate"
          ]
        }
      },
      "additionalProperties": true
    },
    "candidateState": {
      "const": "candidate"
    },
    "candidateDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
