{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/mpa/mpa-canonical-method-input-v1.schema.json",
  "title": "PHI OS MPA Canonical Method Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inputId",
    "subjectReference",
    "methodCode",
    "methodVersion",
    "requestedCapabilities",
    "birthDate",
    "birthTime",
    "birthPlace",
    "timezone",
    "coordinates",
    "calendarCode",
    "inputPrecision",
    "source",
    "customerConfirmation",
    "consentRecordId",
    "purposeCode",
    "fabricatedDefaultsUsed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-MPA-CANONICAL-METHOD-INPUT-v1.0.0"
    },
    "inputId": {
      "type": "string",
      "minLength": 3
    },
    "subjectReference": {
      "type": "string",
      "minLength": 1
    },
    "methodCode": {
      "enum": [
        "NUMEROLOGY",
        "ASTROLOGY",
        "BAZI",
        "HUMAN_DESIGN",
        "I_CHING",
        "TAROT",
        "PSYCHOLOGY"
      ]
    },
    "methodVersion": {
      "type": "string",
      "minLength": 1
    },
    "requestedCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "birthDate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "birthTime": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
    },
    "birthPlace": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z_+\\-]+(?:/[A-Za-z0-9_+\\-]+)+$"
    },
    "coordinates": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latitude",
            "longitude"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "elevationM": {
              "type": [
                "number",
                "null"
              ]
            },
            "accuracyM": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      ]
    },
    "calendarCode": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "inputPrecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "time",
        "place",
        "timezone",
        "coordinates"
      ],
      "properties": {
        "date": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        },
        "time": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        },
        "place": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        },
        "timezone": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        },
        "coordinates": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "sourceReference",
        "sourceVersion"
      ],
      "properties": {
        "sourceType": {
          "enum": [
            "human_declaration",
            "verified_document",
            "imported_governed_record"
          ]
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "customerConfirmation": {
      "type": "boolean"
    },
    "consentRecordId": {
      "type": "string",
      "minLength": 3
    },
    "purposeCode": {
      "type": "string",
      "minLength": 1
    },
    "fabricatedDefaultsUsed": {
      "const": false
    }
  }
}
