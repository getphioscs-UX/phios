{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/mfig-source-binding-v1.json",
  "title": "MFIG Source Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mfigId",
    "generatedAgainstCommit",
    "identityRegistryDigest",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "mfigId": {
      "type": "string"
    },
    "generatedAgainstCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "identityRegistryDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1
    }
  }
}
