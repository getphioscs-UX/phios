{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/asset-approval-package-v1.schema.json",
  "title": "PHI OS Asset Approval Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvalCode",
    "approvalVersion",
    "candidateCode",
    "candidateDigest",
    "reviewCode",
    "reviewDigest",
    "approverCode",
    "approverIndependent",
    "decision",
    "conditions",
    "approvalDigest",
    "approvedAt"
  ],
  "properties": {
    "approvalCode": {
      "type": "string",
      "pattern": "^CAR-APP-[A-Z0-9-]+$"
    },
    "approvalVersion": {
      "type": "string"
    },
    "candidateCode": {
      "type": "string"
    },
    "candidateDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewCode": {
      "type": "string"
    },
    "reviewDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approverCode": {
      "type": "string",
      "minLength": 1
    },
    "approverIndependent": {
      "const": true
    },
    "decision": {
      "enum": [
        "approved",
        "conditionally_approved",
        "rejected",
        "revoked"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvalDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
