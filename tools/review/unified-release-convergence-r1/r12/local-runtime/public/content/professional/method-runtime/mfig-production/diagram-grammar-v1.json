{
  "schemaVersion": "PHI-OS-MFIG-DIAGRAM-GRAMMAR-v1.0.0",
  "status": "FROZEN_PRODUCTION_GRAMMAR",
  "allowedObjects": [
    "node",
    "edge",
    "boundary",
    "label",
    "annotation",
    "legend"
  ],
  "nodeTypes": [
    "AUTHORITY",
    "RUNTIME",
    "CONTRACT",
    "PROCESS",
    "RESULT",
    "GATE",
    "METHOD",
    "SIGNAL",
    "STATE",
    "INPUT",
    "OUTPUT"
  ],
  "edgeRelations": [
    "PROVIDES_CANONICAL_INPUT",
    "PRODUCES",
    "PROJECTS_TO",
    "GOVERNED_HANDOFF",
    "GOVERNS",
    "NORMALIZES",
    "CLASSIFIES",
    "BINDS",
    "RESOLVES",
    "REQUIRES",
    "FEEDS",
    "TRANSITIONS_TO"
  ],
  "rules": {
    "rendererMayInferNewNode": false,
    "rendererMayInferNewEdge": false,
    "rendererMayInferMeaning": false,
    "allSemanticObjectsRequireSourceBinding": true,
    "edgeDirectionExplicit": true
  }
}
