  "canonicalObject": "CanonicalBirthInput",
  "definition": "One client-entered birth input is preserved as a single canonical object and may be transformed only into method-specific internal inputs after governed requirement evaluation. MCD-3 does not execute a Method, grant Production authority, or infer missing personal data.",
  "singleEntryRule": {
    "clientEntersBirthDataOnce": true,
    "sharedAcrossRequestedMethods": true,
    "methodSpecificDuplicateEntryRequired": false,
    "methodSpecificInternalInputsAreDerivedLater": true,
    "canonicalInputMutationByMethodForbidden": true
  },
  "canonicalFields": [
    "birthDate",
    "birthTime",
    "birthPlace",
    "timezone",
    "timeAccuracy",
    "locale",
    "consent",
    "inputVersion"
  ],
  "fieldContract": {
    "birthDate": {
      "type": "string|null",
      "format": "YYYY-MM-DD",
      "calendarSemantics": "PROLEPTIC_GREGORIAN_CIVIL_DATE",
      "unknownAllowed": true,
      "rule": "A missing date remains null and causes each Method whose matrix requires Date to be INPUT_INCOMPLETE later; MCD-3 does not invent a date."
    },
    "birthTime": {
      "type": "string|null",
      "format": "HH:mm:ss",
      "unknownAllowed": true,
      "unknownRepresentation": null,
      "forbiddenSyntheticDefaults": [
        "00:00:00",
        "12:00:00",
        "06:00:00",
        "00:00",
        "12:00",
        "06:00"
      ]
    },
    "birthPlace": {
      "type": "object",
      "requiredKeys": [
        "displayName",
        "countryCode",
        "latitude",
        "longitude"
      ],
      "displayName": "string|null",
      "countryCode": "ISO_3166_1_ALPHA_2|null",
      "latitude": "number[-90,90]|null",
      "longitude": "number[-180,180]|null",
      "coordinatesMayBeNull": true,
      "placeDoesNotEqualCoordinates": true
    },
    "timezone": {
      "type": "object",
      "requiredKeys": [
        "iana",
        "utcOffsetAtBirth",
        "source",
        "confidence"
      ],
      "iana": "IANA_TIME_ZONE_ID|null",
      "utcOffsetAtBirth": "±HH:MM|null",
      "source": "PINNED_IANA_TZDB|GOVERNED_RESOLUTION|HUMAN_DECLARATION|UNKNOWN",
      "confidence": "HIGH|MEDIUM|LOW|UNKNOWN",
      "timezoneDoesNotEqualUtcOffset": true
    },
    "timeAccuracy": {
      "enum": [
        "EXACT",
        "APPROXIMATE",
        "UNKNOWN"
      ]
    },
    "locale": {
      "enum": [
        "en",
        "zh-Hans"
      ]
    },
    "consent": {
      "type": "object",
      "semanticsOwner": "MCD-4_OR_EXISTING_CONSENT_AUTHORITY",
      "mcd3MayInferConsent": false
    },
    "inputVersion": {
      "const": "MCD-3-CANONICAL-BIRTH-INPUT-v1.0.0"
    }
  },
  "independenceRules": {
    "placeNotCoordinates": true,
    "coordinatesNotTimezone": true,
    "timezoneNotUtcOffset": true,
    "placeNotTimezone": true,
    "relatedButIndependentValues": true
  },
  "unknownPreservation": {
    "unknownMustRemainUnknown": true,
    "unknownBirthTimeRequiresNull": true,
    "unknownBirthTimeRequiresTimeAccuracyUnknown": true,
    "unknownCoordinatesRemainNull": true,
    "unknownTimezoneRemainsNull": true,
    "unknownUtcOffsetAtBirthRemainsNull": true,
    "fabricatedDefaultsForbidden": true,
    "runtimeSuccessMayNotJustifyDefaultFilling": true
  },
