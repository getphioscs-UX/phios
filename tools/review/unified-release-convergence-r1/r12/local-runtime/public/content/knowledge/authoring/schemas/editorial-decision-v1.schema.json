{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionCode",
    "actor",
    "decision",
    "reason",
    "sourceDigest",
    "affectedNodes",
    "timestamp",
    "humanDecision"
  ],
  "properties": {
    "decisionCode": {
      "type": "string"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "accept_mapping",
        "create_node",
        "merge_node",
        "split_node",
        "supporting_question_only",
        "no_change",
        "defer",
        "reject"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "affectedNodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^KN-"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "humanDecision": {
      "const": true
    }
  }
}
