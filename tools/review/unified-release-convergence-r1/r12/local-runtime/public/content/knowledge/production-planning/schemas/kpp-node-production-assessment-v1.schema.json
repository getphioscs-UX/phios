{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kpp-node-production-assessment-v1",
  "type": "object",
  "required": [
    "nodeCode",
    "knowledgeCoverageState",
    "independentReadingValue",
    "fragmentSuitability",
    "visualSuitability",
    "runtimeValue",
    "duplicationRisk",
    "localeReadiness",
    "recommendedRole",
    "recommendationOnly"
  ],
  "properties": {
    "nodeCode": {
      "type": "string",
      "minLength": 1
    },
    "knowledgeCoverageState": {
      "enum": [
        "complete",
        "partial",
        "thin",
        "conflicted",
        "missing"
      ]
    },
    "independentReadingValue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "fragmentSuitability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "visualSuitability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "runtimeValue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "duplicationRisk": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "localeReadiness": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "recommendedRole": {
      "enum": [
        "ARTICLE",
        "FRAGMENT",
        "FIGURE",
        "DIAGRAM",
        "STRUCTURED_ONLY",
        "JOURNEY_ONLY",
        "ACADEMY",
        "MULTI_ASSET",
        "NO_PUBLIC_ASSET_REQUIRED",
        "DEFERRED"
      ]
    },
    "recommendationOnly": {
      "const": true
    }
  },
  "additionalProperties": true
}
