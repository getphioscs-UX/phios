{
  "policyCode": "KNR-PACKAGE-C-PUBLIC-EXPERIENCE",
  "version": "1.0.0",
  "route": "/knowledge-search",
  "states": [
    "idle",
    "loading",
    "results",
    "no_coverage",
    "invalid",
    "error"
  ],
  "requirements": [
    "keyboard_submit",
    "locale_control",
    "projection_mode_control",
    "coverage_disclosure",
    "published_source_link",
    "blocked_continuation_disclosure"
  ],
  "prohibited": [
    "personal_data_collection",
    "provider_call",
    "service_recommendation",
    "unpublished_link",
    "generated_answer"
  ]
}
