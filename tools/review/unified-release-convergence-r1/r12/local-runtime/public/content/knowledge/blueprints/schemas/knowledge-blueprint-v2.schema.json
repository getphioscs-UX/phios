{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/knowledge-blueprint-v2.schema.json",
  "title": "PHI OS Universal Knowledge Blueprint v2",
  "type": "object",
  "required": ["contract", "bookCode", "canonicalLanguage", "parts", "nodes"],
  "properties": {
    "contract": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "PHI-OS-KNOWLEDGE-BLUEPRINT-v2.0.0" },
    "bookCode": { "type": "string", "pattern": "^BOOK-(?:[0-9]+|[IVXLCDM]+)$" },
    "bookTitleZhHans": { "type": "string" },
    "canonicalLanguage": { "type": "string", "minLength": 2 },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["partCode", "nodes"],
        "properties": {
          "partCode": { "type": "string", "pattern": "^P[0-9]+$" },
          "title": { "type": "string" },
          "canonicalNodeCount": { "type": "integer", "minimum": 0 },
          "nodes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeCode", "partCode"],
        "properties": {
          "nodeCode": { "type": "string", "minLength": 1 },
          "partCode": { "type": "string", "pattern": "^P[0-9]+$" },
          "status": { "type": "string" },
          "articleRequiredNow": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "productionPolicy": { "type": "object" }
  },
  "additionalProperties": true
}
