{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/customer-reading-claim-ir-v1.schema.json",
  "title": "PHI OS Customer Reading Claim IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "claimId",
    "methodId",
    "semanticDimension",
    "claimType",
    "headline",
    "structuralMeaning",
    "findingRefs",
    "interpretationUnitRefs",
    "evidenceRefs",
    "counterEvidenceRefs",
    "priorityClass",
    "noveltyClass",
    "confidenceClass",
    "conditions",
    "boundaries",
    "questionRelevance",
    "sectionCandidates",
    "lineage"
  ],
  "properties": {
    "schemaVersion": {"const": "PHI-OS-CUSTOMER-READING-CLAIM-IR-v1.0.0"},
    "claimId": {"type": "string", "pattern": "^SMR2-CLAIM-"},
    "methodId": {"enum": ["AST", "BZR", "ZWR", "NUM", "ECR"]},
    "semanticDimension": {"type": "string", "minLength": 1},
    "claimType": {"enum": ["CORE_PATTERN", "SUPPORT", "TENSION", "CONDITION", "TRADEOFF", "OPEN", "TEMPORAL_ACTIVATION", "OBSERVATION"]},
    "headline": {"type": "string", "minLength": 1},
    "structuralMeaning": {"type": "string", "minLength": 1},
    "findingRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "interpretationUnitRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "counterEvidenceRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "priorityClass": {"enum": ["PRIMARY", "SECONDARY", "UNSPECIFIED"]},
    "noveltyClass": {"enum": ["UNASSESSED"]},
    "confidenceClass": {"enum": ["ADMITTED_AUTHORITY", "ADMITTED_WITH_BOUNDARY"]},
    "conditions": {"type": "array"},
    "boundaries": {"type": "array"},
    "questionRelevance": {"type": "object"},
    "sectionCandidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "lineage": {"type": "object"}
  }
}
