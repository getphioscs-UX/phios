{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schema/rre/canonical-runtime-readout-v1.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "dataType",
    "dataDomain",
    "readoutCode",
    "readoutVersion",
    "realityReference",
    "observationSummary",
    "runtimeSignature",
    "patterns",
    "constraints",
    "load",
    "stability",
    "drift",
    "recovery",
    "unknowns",
    "resolutionLimits",
    "confidence",
    "lineage",
    "authorityReference",
    "persistenceDecision",
    "persistentStoreWriteAllowed",
    "storageExecutionPerformed",
    "diagnosisCreated",
    "professionalJudgmentCreated",
    "navigationDecisionCreated",
    "metricCreated",
    "readoutDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "PHI-OS-RRE-CANONICAL-RUNTIME-READOUT-v1.0.0"
    },
    "dataType": {
      "const": "REALITY_READOUT_RECORD"
    },
    "dataDomain": {
      "const": "REALITY_READOUT"
    },
    "readoutCode": {
      "type": "string",
      "pattern": "^RRE-READOUT-[A-Z0-9-]+$"
    },
    "readoutVersion": {
      "type": "string"
    },
    "realityReference": {
      "type": "object",
      "required": [
        "code",
        "version",
        "digest"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "observationSummary": {
      "type": "object"
    },
    "runtimeSignature": {
      "type": "object"
    },
    "patterns": {
      "type": "array"
    },
    "constraints": {
      "type": "array"
    },
    "load": {
      "type": "object"
    },
    "stability": {
      "type": "object"
    },
    "drift": {
      "type": "object"
    },
    "recovery": {
      "type": "object"
    },
    "unknowns": {
      "type": "array"
    },
    "resolutionLimits": {
      "type": "array"
    },
    "confidence": {
      "type": "object"
    },
    "lineage": {
      "type": "object"
    },
    "authorityReference": {
      "type": "string"
    },
    "persistenceDecision": {
      "enum": [
        "DENY",
        "REQUIRE_CONSENT",
        "UNRESOLVED",
        "ALLOW_SESSION",
        "ALLOW_SERVICE_SCOPE"
      ]
    },
    "persistentStoreWriteAllowed": {
      "type": "boolean"
    },
    "storageExecutionPerformed": {
      "const": false
    },
    "diagnosisCreated": {
      "const": false
    },
    "professionalJudgmentCreated": {
      "const": false
    },
    "navigationDecisionCreated": {
      "const": false
    },
    "metricCreated": {
      "const": false
    },
    "readoutDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
