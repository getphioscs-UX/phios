{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/rmo/reality-version-request-v1.schema.json",
  "title": "PHI OS RMO Reality Version Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "realityCode", "nextRealityVersion", "nextRealityVersionSequence", "changeType",
    "changeReferences", "revisedAt", "providerUsed", "aiUsed"
  ],
  "properties": {
    "realityCode": {"type": "string", "pattern": "^RMO-REALITY-[A-Z0-9-]{4,100}$"},
    "nextRealityVersion": {"$ref": "#/$defs/semver"},
    "nextRealityVersionSequence": {"type": "integer", "minimum": 2},
    "changeType": {
      "enum": [
        "COMPONENTS_INCORPORATED", "LIFECYCLE_ADVANCED", "COMPONENTS_REVISED",
        "UNKNOWN_RESOLUTION_RECORDED", "CORRECTION_RECORDED"
      ]
    },
    "changeReferences": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "revisedAt": {"type": "string", "format": "date-time"},
    "providerUsed": {"const": false},
    "aiUsed": {"const": false}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
  }
}
