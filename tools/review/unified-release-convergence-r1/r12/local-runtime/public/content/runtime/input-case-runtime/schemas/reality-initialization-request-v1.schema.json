{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/icr/reality-initialization-request-v1.schema.json",
  "title": "PHI OS ICR to RMO Reality Initialization Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "initializationRequestCode",
    "initializationRequestVersion",
    "sourceCaseCode",
    "sourceCaseVersion",
    "sourceCaseDigest",
    "verifiedInputReferences",
    "governanceReferences",
    "sourceRuntimeCode",
    "targetRuntimeCode",
    "targetWorkCode",
    "requestedObject",
    "requestedOutputDataType",
    "handoffState",
    "rmoAcceptanceRequired",
    "rmoExecutionActivated",
    "realityObjectCreated",
    "requestedAt",
    "requestDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "PHI-OS-REALITY-INITIALIZATION-REQUEST-v1.0.0"},
    "initializationRequestCode": {
      "type": "string",
      "pattern": "^ICR-RMO-INIT-[A-Z0-9-]{4,100}$"
    },
    "initializationRequestVersion": {"$ref": "#/$defs/semver"},
    "sourceCaseCode": {"type": "string", "pattern": "^ICR-CASE-[A-Z0-9-]{4,100}$"},
    "sourceCaseVersion": {"$ref": "#/$defs/semver"},
    "sourceCaseDigest": {"$ref": "#/$defs/digest"},
    "verifiedInputReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verifiedInputCode",
          "verifiedInputVersion",
          "verifiedInputDigest",
          "inputType",
          "verificationState",
          "projectionEligibility"
        ],
        "properties": {
          "verifiedInputCode": {"type": "string"},
          "verifiedInputVersion": {"$ref": "#/$defs/semver"},
          "verifiedInputDigest": {"$ref": "#/$defs/digest"},
          "inputType": {"type": "string"},
          "verificationState": {"const": "VERIFIED"},
          "projectionEligibility": {"const": "ELIGIBLE"}
        }
      }
    },
    "governanceReferences": {"$ref": "#/$defs/rdgLifecycleReferences"},
    "sourceRuntimeCode": {"const": "ICR"},
    "targetRuntimeCode": {"const": "RMO"},
    "targetWorkCode": {"const": "RMO-W1"},
    "requestedObject": {"const": "REALITY_V1"},
    "requestedOutputDataType": {"const": "RUNTIME_STATE_RECORD"},
    "handoffState": {"const": "READY_FOR_RMO_ACCEPTANCE"},
    "rmoAcceptanceRequired": {"const": true},
    "rmoExecutionActivated": {"const": false},
    "realityObjectCreated": {"const": false},
    "requestedAt": {"type": "string", "format": "date-time"},
    "requestDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rdgLifecycleReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "rdgAuthorityReference",
        "persistenceClass",
        "persistenceDecisionReference",
        "persistenceRegistryReference",
        "persistenceEligibilityGateReference",
        "consentClass",
        "consentReference",
        "consentRegistryReference",
        "retentionClass",
        "retentionRegistryReference",
        "deletionState",
        "deletionRuntimeReference"
      ],
      "properties": {
        "mode": {"const": "RDG_REFERENCE_ONLY"},
        "rdgAuthorityReference": {
          "const": "content/governance/reality-data-governance/registries/reality-data-registry-v1.json"
        },
        "persistenceClass": {"type": "string", "minLength": 1},
        "persistenceDecisionReference": {
          "type": "string",
          "pattern": "^RDG-PERSISTENCE-DECISION-[A-Z0-9-]{4,100}$"
        },
        "persistenceRegistryReference": {
          "const": "content/governance/reality-data-governance/registries/canonical-persistence-class-registry-v1.json"
        },
        "persistenceEligibilityGateReference": {
          "const": "content/governance/reality-data-governance/contracts/persistence-eligibility-gate-v1.json"
        },
        "consentClass": {"type": "string", "minLength": 1},
        "consentReference": {"type": "string", "minLength": 1},
        "consentRegistryReference": {
          "const": "content/governance/reality-data-governance/registries/canonical-consent-class-registry-v1.json"
        },
        "retentionClass": {"type": "string", "minLength": 1},
        "retentionRegistryReference": {
          "const": "content/governance/reality-data-governance/registries/canonical-data-retention-registry-v1.json"
        },
        "deletionState": {"type": "string", "minLength": 1},
        "deletionRuntimeReference": {
          "const": "content/governance/reality-data-governance/contracts/deletion-tombstone-runtime-v1.json"
        }
      }
    }
  }
}
