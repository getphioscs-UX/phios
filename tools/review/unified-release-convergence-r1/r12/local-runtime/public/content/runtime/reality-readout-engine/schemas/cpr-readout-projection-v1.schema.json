{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schema/rre/cpr-readout-projection-v1.schema.json",
  "type": "object",
  "required": [
    "projectionCode",
    "projectionVersion",
    "sourceReadoutReference",
    "targets",
    "cprPresentationCreated",
    "cprRegistryWritten",
    "surfaceActivated",
    "projectionDigest"
  ],
  "properties": {
    "projectionCode": {
      "type": "string",
      "pattern": "^RRE-CPR-PROJECTION-[A-Z0-9-]+$"
    },
    "projectionVersion": {
      "type": "string"
    },
    "sourceReadoutReference": {
      "type": "object",
      "required": [
        "code",
        "version",
        "digest"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "targetCode",
          "targetRuntime",
          "cprSurface",
          "handoffState"
        ],
        "properties": {
          "targetCode": {
            "type": "string"
          },
          "targetRuntime": {
            "type": "string"
          },
          "cprSurface": {
            "type": "string"
          },
          "handoffState": {
            "enum": [
              "READY_FOR_CPR_SELECTION",
              "REQUIRES_RR_RELEASED_REPORT"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "cprPresentationCreated": {
      "const": false
    },
    "cprRegistryWritten": {
      "const": false
    },
    "surfaceActivated": {
      "const": false
    },
    "reportCreated": {
      "const": false
    },
    "professionalJudgmentCreated": {
      "const": false
    },
    "projectionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
