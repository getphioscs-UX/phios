{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/rmo/reality-diff-request-v1.schema.json",
  "title": "PHI OS RMO Reality Diff Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["diffCode", "diffVersion", "createdAt", "providerUsed", "aiUsed"],
  "properties": {
    "diffCode": {"type": "string", "pattern": "^RMO-DIFF-[A-Z0-9-]{4,100}$"},
    "diffVersion": {"$ref": "#/$defs/semver"},
    "createdAt": {"type": "string", "format": "date-time"},
    "providerUsed": {"const": false},
    "aiUsed": {"const": false}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
  }
}
