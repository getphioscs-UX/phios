{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/rmo/canonical-reality-entity-v1.schema.json",
  "title": "PHI OS Canonical Reality Entity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "entityCode", "entityVersion", "componentType", "entityType", "entityRole",
    "canonicalReference", "realityReference", "dataNature", "certainty", "sourceReferences",
    "recordStatus", "authorityReference", "operationalMode", "persistentStoreWriteAllowed",
    "createdAt", "entityDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "PHI-OS-CANONICAL-REALITY-ENTITY-v1.0.0"},
    "entityCode": {"type": "string", "pattern": "^RMO-ENTITY-[A-Z0-9-]{4,100}$"},
    "entityVersion": {"$ref": "#/$defs/semver"},
    "componentType": {"const": "REALITY_ENTITY"},
    "entityType": {"type": "string", "minLength": 1},
    "entityRole": {"enum": ["PRIMARY_SUBJECT", "PARTICIPANT", "CONTEXT", "RESOURCE", "ENVIRONMENT"]},
    "canonicalReference": {"type": "string", "minLength": 1, "maxLength": 200},
    "realityReference": {"$ref": "#/$defs/realityReference"},
    "dataNature": {"type": "string", "minLength": 1},
    "certainty": {"type": "string", "minLength": 1},
    "sourceReferences": {"$ref": "#/$defs/referenceArray"},
    "recordStatus": {"const": "REGISTERED"},
    "authorityReference": {"const": "content/runtime/reality-model-runtime/contracts/entity-runtime-contract-v1.json"},
    "operationalMode": {"const": "VALIDATION_ONLY"},
    "persistentStoreWriteAllowed": {"const": false},
    "createdAt": {"type": "string", "format": "date-time"},
    "entityDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "referenceArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "realityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realityCode", "realityVersion", "realityDigest"],
      "properties": {
        "realityCode": {"type": "string", "pattern": "^RMO-REALITY-[A-Z0-9-]{4,100}$"},
        "realityVersion": {"$ref": "#/$defs/semver"},
        "realityDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
