  },
  "rules": {
    "birthDataIsHighlySensitive": true,
    "birthDataMayBecomeRuntimeMemoryByDefault": false,
    "birthDataMayBeDuplicatedPerMethod": false,
    "methodMayCorrectBirthData": false,
    "providerMayInferMissingBirthTime": false,
    "rectificationIsSilentVerification": false,
    "coordinateMustRemainSeparatelyGoverned": true,
