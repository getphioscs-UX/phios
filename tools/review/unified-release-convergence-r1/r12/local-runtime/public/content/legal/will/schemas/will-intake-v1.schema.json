  "$defs": {
    "personIdList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "assetType",
        "description"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "assetType": {
          "enum": [
            "IMMOVABLE_PROPERTY",
            "BANK_ACCOUNT",
            "UNIT_TRUST",
            "LISTED_SECURITY",
            "PRIVATE_COMPANY",
            "PARTNERSHIP",
            "SOLE_PROPRIETORSHIP",
            "EPF",
            "INSURANCE",
            "PRS",
            "VEHICLE",
            "JEWELLERY",
            "SAFE_DEPOSIT",
            "DIGITAL_ASSET",
            "INTELLECTUAL_PROPERTY",
            "DOMAIN_NAME",
            "ONLINE_ACCOUNT",
            "CRYPTO_ASSET",
            "OTHER"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "ownershipStatement": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "referenceLast4": {
          "type": "string",
          "maxLength": 4
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "share": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beneficiaryPersonId",
        "percentage"
      ],
      "properties": {
        "beneficiaryPersonId": {
          "type": "string",
          "minLength": 1
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distributionId",
        "distributionType",
        "beneficiaryPersonIds",
        "sourceConfirmation"
      ],
      "properties": {
        "distributionId": {
          "type": "string",
          "minLength": 1
        },
        "distributionType": {
          "enum": [
            "SPECIFIC_GIFT",
            "PERCENTAGE_GIFT",
            "EQUAL_SHARE_GIFT",
            "RESIDUE_SHARE",
            "SUBSTITUTE_BENEFICIARY",
            "PER_ASSET_DISTRIBUTION",
            "CLASS_DISTRIBUTION",
            "SURVIVORSHIP_CONDITION",
            "AGE_CONDITION",
            "TRUST_CONDITION"
          ]
        },
        "assetId": {
          "type": "string"
        },
        "beneficiaryPersonIds": {
          "$ref": "#/$defs/personIdList"
        },
        "percentageShares": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/share"
          }
        },
        "substituteBeneficiaryPersonIds": {
          "$ref": "#/$defs/personIdList"
        },
        "classDefinition": {
          "type": "string"
        },
        "survivorshipCondition": {
          "type": "string"
        },
        "ageCondition": {
          "type": "string"
        },
        "trustCondition": {
          "type": "string"
        },
        "sourceConfirmation": {
          "type": "boolean"
        }
      }
    },
    "residueShare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beneficiaryPersonId",
        "percentage"
      ],
      "properties": {
        "beneficiaryPersonId": {
          "type": "string",
          "minLength": 1
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "substituteBeneficiaryPersonId": {
          "type": "string"
        },
        "survivorshipCondition": {
          "type": "string"
        },
        "ageCondition": {
          "type": "string"
        },
        "trustCondition": {
          "type": "string"
        }
      }
    },
    "structuredInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructionId",
        "instructionType",
        "textProvidedByCustomer"
      ],
      "properties": {
        "instructionId": {
          "type": "string",
          "minLength": 1
        },
        "instructionType": {
          "type": "string",
          "minLength": 1
        },
        "textProvidedByCustomer": {
          "type": "string"
        },
        "requiresLegalReview": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "x-phi-os": {
    "work": "DAR-W3",
