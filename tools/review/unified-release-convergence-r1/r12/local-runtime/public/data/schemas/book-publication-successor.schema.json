{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/book-publication-successor.schema.json",
  "title": "PHI OS additive publication manifest successor",
  "type": "object",
  "required": ["book_id", "canonical_book_id", "bookCode", "volume", "canonical_title", "content_status", "parts", "successorAuthority"],
  "properties": {
    "book_id": {"type":"string", "pattern":"^phios-volume-[1-8]$"},
    "canonical_book_id": {"type":"string", "pattern":"^book-[1-8]$"},
    "bookCode": {"type":"string", "pattern":"^BOOK-[1-8]$"},
    "volume": {"type":"integer", "minimum":1, "maximum":8},
    "canonical_title": {"type":"object", "required":["en","zh-Hans"], "properties":{"en":{"type":"string","minLength":1},"zh-Hans":{"type":"string","minLength":1}}},
    "content_status": {"enum":["architecture-only","content-complete","authority-pending"]},
    "partAdmission": {"enum":["PENDING_USER_AUTHORITY"]},
    "parts": {"type":"array", "items":{"type":"object","required":["id","number","title","status","chapters"]}}
  },
  "allOf": [{"if":{"properties":{"content_status":{"const":"authority-pending"}}},"then":{"required":["partAdmission"],"properties":{"parts":{"maxItems":0}}},"else":{"properties":{"parts":{"minItems":1}}}}]
}
