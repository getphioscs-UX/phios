{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/external-readers/reader-registry.v1.json",
  "title": "PHI OS External Reader Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "readers"],
  "properties": {
    "schema_version": {"const": "phi-os.external-reader-registry.v1"},
    "readers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reader_id",
          "reader_name",
          "reader_version",
          "reader_category",
          "input_requirements",
          "output_schema",
          "renderer_status",
          "interpretation_status",
          "professional_scope",
          "active"
        ],
        "properties": {
          "reader_id": {
            "enum": ["human_design", "bazi", "ziwei", "gene_keys", "astrology"]
          },
          "reader_name": {
            "type": "object",
            "required": ["en", "zh-Hans"],
            "properties": {
              "en": {"type": "string", "minLength": 1},
              "zh-Hans": {"type": "string", "minLength": 1}
            }
          },
          "reader_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "reader_category": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "input_requirements": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "output_schema": {"type": "string", "minLength": 1},
          "registry_schema_version": {"type": "string", "minLength": 1},
          "renderer_status": {
            "enum": ["not_implemented", "upload_only", "uploaded_chart_only", "available"]
          },
          "calculation_status": {
            "enum": ["not_implemented", "manual_only", "available"]
          },
          "registry_status": {
            "enum": ["scaffold", "active", "deprecated"]
          },
          "interpretation_status": {
            "enum": ["infrastructure_only", "registry_ready", "professional_only"]
          },
          "professional_scope": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "legal_or_license_notes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "supported_languages": {
            "type": "array",
            "items": {"enum": ["en", "zh-Hans"]}
          },
          "active": {"type": "boolean"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
