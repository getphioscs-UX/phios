{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/external-readers/interpretation.v1.json",
  "title": "PHI OS External Reader Interpretation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interpretation_id",
    "reader_type",
    "chart_element",
    "source_reference",
    "interpretation",
    "runtime_domain",
    "confidence",
    "limitations",
    "professional_id",
    "client_visible"
  ],
  "properties": {
    "interpretation_id": {"type": "string", "minLength": 1},
    "reader_type": {
      "enum": ["human_design", "bazi", "ziwei", "gene_keys", "astrology"]
    },
    "client_id": {"type": "string", "minLength": 1},
    "service_id": {"type": "string", "minLength": 1},
    "chart_id": {"type": "string", "minLength": 1},
    "chart_element": {"type": "string", "minLength": 1},
    "source_reference": {"$ref": "source-label.schema.json"},
    "interpretation": {"type": "string", "minLength": 1},
    "runtime_domain": {"$ref": "#/$defs/runtimeDomain"},
    "confidence": {"enum": ["low", "moderate", "high", "not_assessed"]},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "professional_id": {"type": "string", "minLength": 1},
    "client_visible": {"type": "boolean"},
    "status": {
      "enum": ["draft", "professional_review", "approved", "client_visible", "superseded"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "runtime_reading_generated": {"const": false},
    "runtime_evidence_written": {"const": false},
    "runtime_memory_written": {"const": false}
  },
  "$defs": {
    "runtimeDomain": {
      "enum": [
        "carrier",
        "decision",
        "environment",
        "relationship",
        "experience",
        "expression",
        "action",
        "time",
        "resources",
        "constraints",
        "signatures",
        "navigation"
      ]
    }
  }
}
