+function parseRange(header,size){if(!header)return null;const m=/^bytes=(\d*)-(\d*)$/.exec(header);if(!m||(!m[1]&&!m[2]))fail('LARGE_PDF_RANGE_INVALID',416);let start,end;if(!m[1]){const suffix=Number(m[2]);if(!Number.isSafeInteger(suffix)||suffix<=0)fail('LARGE_PDF_RANGE_INVALID',416);start=Math.max(0,size-suffix);end=size-1;}else{start=Number(m[1]);end=m[2]?Number(m[2]):size-1;}if(!Number.isSafeInteger(start)||!Number.isSafeInteger(end)||start<0||start>=size||end<start)fail('LARGE_PDF_RANGE_INVALID',416);end=Math.min(end,size-1);return {offset:start,length:end-start+1};}
