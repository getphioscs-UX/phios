      "content": [
        {
          "id": "SGP-CONSTITUTION",
          "text": "Singapore’s National Archives presents constitutional documents spanning 1819–1965, covering colonial institutional changes and the emergence of a republic. This is not a substitute for earlier history or a complete social history.",
          "period": {
            "label": {
              "zh-Hans": "1819–1965",
              "en": "1819–1965"
            },
            "startYear": 1819,
            "endYear": 1965,
            "approximate": true
          },
          "source": "https://corporate.nas.gov.sg/outreach/law-of-the-land/",
          "next": "https://corporate.nas.gov.sg/outreach/law-of-the-land/"
        },
        {
          "id": "SGP-INDEPENDENCE",
          "text": "The National Archives of Singapore lists the Proclamation of the Republic of Singapore dated 9 August 1965, providing a document-led path into state formation.",
          "period": {
            "label": {
              "zh-Hans": "1965年8月9日",
              "en": "9 August 1965"
            },
            "startYear": 1965,
            "endYear": 1965,
            "approximate": true
          },
          "source": "https://corporate.nas.gov.sg/outreach/law-of-the-land/",
          "next": "https://corporate.nas.gov.sg/outreach/law-of-the-land/"
        },
        {
          "id": "SGP-REGIONAL",
          "text": "The UN treaty record lists Malaysia, Singapore and Indonesia as signatories on 8 August 1967 to the declaration establishing ASEAN. This is a regional-history milestone, not proof of domestic development outcomes.",
          "period": {
            "label": {
              "zh-Hans": "1967年8月8日",
              "en": "8 August 1967"
            },
            "startYear": 1967,
            "endYear": 1967,
