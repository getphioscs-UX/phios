      "content": [
        {
          "id": "IDN-EARLY",
          "text": "UNESCO identifies Sangiran as a major fossil site for understanding early humans. Archaeology at this locality and the formation of modern Indonesia belong to different timescales.",
          "period": {
            "label": {
              "zh-Hans": "史前考古记录",
              "en": "Prehistoric archaeological record"
            },
            "startYear": null,
            "endYear": null,
            "approximate": true
          },
          "source": "https://whc.unesco.org/en/list/593/",
          "next": "https://whc.unesco.org/en/list/593/"
        },
        {
          "id": "IDN-INDEPENDENCE",
          "text": "Indonesia’s State Secretariat recounts the preparation and proclamation of independence on 17 August 1945. Subsequent recognition, local experiences and development require separate sources.",
          "period": {
            "label": {
              "zh-Hans": "1945年8月17日",
              "en": "17 August 1945"
            },
            "startYear": 1945,
            "endYear": 1945,
            "approximate": true
