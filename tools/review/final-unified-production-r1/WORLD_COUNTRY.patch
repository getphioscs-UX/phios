+function entry(){return '<header><p>'+t('同一主体，不同来源与条件','One subject, distinct sources and conditions')+'</p><h1>'+t('国家 Profile','Country Profile')+'</h1><p>'+t('无需登录。阅读公开来源、统计期间与六维结构；浏览不授予国家代表或编辑权限。','No login required. Read public sources, periods and six dimensions. Viewing grants no representative or editing authority.')+'</p></header>';}
