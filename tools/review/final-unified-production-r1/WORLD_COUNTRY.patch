ea1","dimensionIds":["environment"],"title":{"en":"Inflation, consumer prices (annual %)","zh-Hans":"消费价格通胀率（年度%）"},"sourceObservationRef":"FP.CPI.TOTL.ZG:MYS:2025"},{"observationId":"SL.EMP.TOTL.SP.ZS:MYS:2025","subject":{"subjectId":"WORLD:COUNTRY:MYS","type":"COUNTRY","countryCode":"MYS","spatialLevel":"COUNTRY"},"observationClass":"MEASUREMENT","knowledgeState":"CANONICAL_HISTORY","observedAt":"2025","retrievedAt":"2026-11-02T03:37:55.364989+00:00","sourceRefs":[{"id":"WDI:SL.EMP.TOTL.SP.ZS","url":"https://api.worldbank.org/v2/country/MY;SG;ID/indicator/SL.EMP.TOTL.SP.ZS?format=json&date=2019:2026&per_page=100","metadataUrl":"https://api.worldbank.org/v2/sources/2/series/SL.EMP.TOTL.SP.ZS/metadata?format=json","sourceVersion":"a8346965f4025238006534ebc27a41c91d954a9555e2e59673f1598fff90919c","datasetUpdatedAt":"2026-10-08","publicationDate":null,"licenseStatus":"INDICATOR_CC_BY_4_0_VERIFIED"}],"lineage":{"sourceClass":"OFFICIAL_DATASET","providerId":"WORLD_BANK","rawSnapshotRef":"content/world/world-country-public-evidence-r2-dbce500dd6254804.json#SL.EMP.TOTL.SP.ZS:MYS:2025","claimRefs":["WDI-REPORTED:SL.EMP.TOTL.SP.ZS:MYS:2025"],"evidenceRefs":["WDI-REPORTED:SL.EMP.TOTL.SP.ZS:MYS:2025"],"rreReadoutRef":null,"transformationRefs":["WORLD_OBSERVATION_COUNTRY_P2_V1"],"archiveValidationReferenceTime":"2026-11-02T03:37:55.364989+00:00","validationMode":"PINNED_SOURCE_REFERENCE_TIME_REPLAY_NOT_A_HISTORICAL_ACTION_RECORD","archiveAdmissionState":"ADMITTED","currentnessClaimed":false},"measurement":{"objectDefinition":"Employment to population ratio is the proportion of a country's population that is employed.","indicatorId":"SL.EMP.TOTL.SP.ZS","value":63.631,"unit":"percent","currency":null,"priceBasis":null,"scale":"COUNTRY","baseline":null,"window":{"start":2025,"end":2025,"samplingFrequency":"ANNUAL"},"resolution":"SOURCE_REPORTED_STATISTICAL_YEAR_LABEL_ONLY","calibration":null,"comparability":"PARTIALLY_COMPARABLE","error":{"known":false,"description":"SOURCE_ESTIMATE_OR_MODEL"},"missingness":{"state":"SOURCE_VALUE_AVAILABLE","description":"Source-reported dated value; not a live observation."}},"uncertainty":{"state":"PARTIAL_BOUND","description":"Data on employment by status are drawn from labor force surveys and household surveys, supplemented by official estimates and censuses for a small group of countries. The labor force survey is the most comprehensive source for internationally comparable employment, but there are still some limitations for comparing data across countries and over time even within a country. \n\nComparability of employment ratios across countries is affected by variations in definitions of employment and population. The biggest difference results from the age range used to define labor force activity. The population base for employment ratios can also vary. Most countries use the resident, non-institutionalized population of working age living in private households, which excludes members of the armed forces and individuals residing in mental, penal, or other types of institutions. But some countries include members of the armed forces in the population base of their employment ratio while excluding them from employment data.\n\nThe reference period of a census or survey is another important source of differences: in some countries data refer to people's status on the day of the census or survey or during a specific period before the inquiry date, while in others data are recorded without reference to any period. Employment ratios tend to vary during the year as seasonal workers enter and leave.\n\nThis indicator also has a gender bias because women who do not consider their work employment or who are not perceived as working tend to be undercounted. This bias has different effects across countries and reflects demographic, social, legal, and cultural trends and norms.","unresolved":["NO_CURRENT_WORLD_STATE_INFERENCE","NO_CAUSALITY","NO_POLICY_CONCLUSION"]},"boundary":{"publicOnly":true,"personalFact