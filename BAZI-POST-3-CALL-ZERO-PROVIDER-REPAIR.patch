+export async function recomposeBaziPublication(args,evaluate){const attempts=[];let lastIr,lastReceipt;for(let pass=0;pass<=RECOMPOSE_PASSES.length;pass++){const ir=await compileBaziDeepPublication({...args,recomposePass:pass}),receipt=await evaluate(ir,pass);lastIr=ir;lastReceipt=receipt;attempts.push({pass,operation:pass?RECOMPOSE_PASSES[pass-1]:'INITIAL',fitStatus:receipt.fitStatus});if(receipt.fitStatus==='PASS')return {ir,receipt:{...receipt,fitStatus:pass?'PASS_AFTER_RECOMPOSE':'PASS',recomposePasses:attempts},providerCalls:0};}return {ir:lastIr,receipt:{...lastReceipt,fitStatus:'FAIL',error:'PUBLICATION_OVERFLOW_UNRESOLVED',recomposePasses:attempts},state:'PUBLICATION_REPAIR',providerCalls:0};}
