+
+for(const batch of ['B01','B02','B03'])write(ROOT+'REPAIR-'+batch+'-AUTHORITY.json',projectBaziBatchAuthority(pack,batch));
+const targets={S03:'时序边界：当前己巳／丙寅已提供，缺少的是日期与完整序列。',S04:'补充丙七杀藏寅、角色与标准压力、偏印与比肩的承载；修正时序缺失说法。',S05:'检查收入／成本／留存的独特解释及日期边界。',S06:'以亲密关系解读开头；增加被理解、情绪回应、信任与日常共同生活；修正时序边界。',S07:'以家庭支持解读开头；增加照顾、隐形劳动、默认组织者与实际分担；修正时序边界。',S09:'区分当前时序已有与完整序列未提供。',S10:'保留原结构，只补正印支持、七杀责任、火调候的区别。'};
+const patchMap=[];for(const s of snapshot.sections)for(const l of LOCALES){const text=s[FIELD[l]],paragraphs=text.split(/\n\s*\n/);let cursor=0;paragraphs.forEach((p,i)=>{const start=text.indexOf(p,cursor);cursor=start+p.length;const flags=[];if(/没有|缺少|等待|not provided|no (luck|specific)|not available/i.test(p)&&/大运|流年|luck|annual/i.test(p))flags.push('TIMING_BOUNDARY_AUDIT');if(['S06','S07'].includes(s.sectionId)&&i===0)flags.push('INTERPRETATION_FIRST_LEAD');if(s.sectionId==='S04'&&i<2)flags.push('SEVEN_KILLINGS_DEPTH');if(['S06','S07'].includes(s.sectionId)&&i===1)flags.push('DOMAIN_LIVED_DEPTH');if(s.sectionId==='S10'&&/己|丙/.test(p))flags.push('RESOURCE_PRESSURE_DISTINCTION');if(flags.length)patchMap.push({sectionId:s.sectionId,locale:l,paragraph:i+1,start,end:cursor,sourceText:p,flags,target:targets[s.sectionId],sourceUnitDigest:s.unitDigests[l],state:'HUMAN_REPAIR_PENDING'});});}
