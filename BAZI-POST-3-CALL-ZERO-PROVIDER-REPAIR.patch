+    "closingSummary": {
+      "zh-Hans": [
+        {
+          "text": "这种结构在顺畅状态下，往往表现为能够发现问题、拆解复杂信息，并把想法转成可执行成果。",
+          "start": 177,
+          "end": 219,
+          "role": "DOMAIN_INTERPRETATION",
+          "roles": [
+            "DOMAIN_INTERPRETATION"
+          ],
+          "sectionId": "S08",
+          "locale": "zh-Hans",
+          "authorityDigest": "3d39eb86506e43e80c1df5333539504c154e1794d1a2f8af7f8c23c69c91b97c",
+          "compilerVersion": "BDM-PUBLICATION-2",
+          "paragraphIndex": 1
+        },
+        {
+          "text": "长期周期的作用，不是替原局重新定义一个命运，而是在不同阶段改变哪些结构功能更容易被调用、哪些环节需要承担更大负荷。",
+          "start": 0,
+          "end": 57,
+          "role": "DOMAIN_INTERPRETATION",
+          "roles": [
+            "DOMAIN_INTERPRETATION"
+          ],
+          "sectionId": "S09",
+          "locale": "zh-Hans",
+          "authorityDigest": "3d39eb86506e43e80c1df5333539504c154e1794d1a2f8af7f8c23c69c91b97c",
+          "compilerVersion": "BDM-PUBLICATION-2",
+          "paragraphIndex": 0
+        },
+        {
+          "text": "合说明两者之间产生连接与牵制，不等于已经完成五行转化；现有资料也没有给出化合结论。",
+          "start": 182,
+          "end": 223,
+          "role": "DOMAIN_INTERPRETATION",
+          "roles": [
+            "DOMAIN_INTERPRETATION"
+          ],
+          "sectionId": "S10",
+          "locale": "zh-Hans",
+          "authorityDigest": "3d39eb86506e43e80c1df5333539504c154e1794d1a2f8af7f8c23c69c91b97c",
+          "compilerVersion": "BDM-PUBLICATION-2",
+          "paragraphIndex": 1
+        }
+      ],
+      "en": [
+        {
+          "text": "The principal vulnerability in this chart is not simply the volume of external demands.",
+          "start": 0,
+          "end": 87,
+          "role": "DOMAIN_INTERPRETATION",
+          "roles": [
+            "DOMAIN_INTERPRETATION"
+          ],
+          "sectionId": "S08",
+          "locale": "en",
+          "authorityDigest": "3d39eb86506e43e80c1df5333539504c154e1794d1a2f8af7f8c23c69c91b97c",
+          "compilerVersion": "BDM-PUBLICATION-2",
+          "paragraphIndex": 0
+        },
+        {
+          "text": "Long-term cycles do not replace the natal structure with a new destiny.",
+          "start": 0,
+          "end": 71,
+          "role": "DOMAIN_INTERPRETATION",
+          "roles": [
+            "DOMAIN_INTERPRETATION"
+          ],
+          "sectionId": "S09",
+          "locale": "en",
+          "authorityDigest": "3d39eb86506e43e80c1df5333539504c154e1794d1a2f8af7f8c23c69c91b97c",
+          "compilerVersion": "BDM-PUBLICATION-2",
+          "paragraphIndex": 0
+        },
+        {
+          "text": "No Gregorian year, age, start date, or end date has been provided, so this combination can only be examined as a structural interaction with the natal chart.",
+          "start": 85,
+          "end": 242,
+          "role": "DOMAIN_INTERPRETATION",
+          "roles": [
+            "DOMAIN_INTERPRETATION",
+            "MECHANISM"
+          ],
