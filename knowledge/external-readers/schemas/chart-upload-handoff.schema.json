{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getphios.com/schemas/external-readers/chart-upload-handoff.schema.json",
  "title": "PHI OS External Reader Handoff",
  "type": "object",
  "required": ["schema_version", "handoff_id", "intake_id", "client_id", "reader_type", "queue_tasks"],
  "properties": {
    "schema_version": {"const": "phi-os.external-reader-handoff.v1"},
    "handoff_id": {"type": "string", "minLength": 1},
    "intake_id": {"type": "string", "minLength": 1},
    "client_id": {"type": "string", "minLength": 1},
    "reader_type": {"enum": ["human_design", "bazi", "ziwei", "gene_keys", "astrology"]},
    "queue_tasks": {"type": "array", "minItems": 1},
    "runtime_evidence_written": {"const": false},
    "runtime_memory_written": {"const": false},
    "required_action_generated": {"const": false}
  }
}
